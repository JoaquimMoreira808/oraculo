.PHONY: help install dev build start docker-build docker-up docker-down docker-logs clean\n\n# Default target\nhelp:\n\t@echo \"Omni-Data - Sistema de Inventário\"\n\t@echo \"\"\n\t@echo \"Comandos disponíveis:\"\n\t@echo \"  install      - Instalar dependências\"\n\t@echo \"  dev          - Iniciar desenvolvimento\"\n\t@echo \"  build        - Build para produção\"\n\t@echo \"  start        - Iniciar produção\"\n\t@echo \"  docker-build - Build Docker\"\n\t@echo \"  docker-up    - Subir containers\"\n\t@echo \"  docker-down  - Parar containers\"\n\t@echo \"  docker-logs  - Ver logs\"\n\t@echo \"  clean        - Limpar arquivos temporários\"\n\ninstall:\n\tnpm install\n\ndev:\n\t./dev.sh\n\nbuild:\n\tnpm run build\n\nstart:\n\tnpm start\n\ndocker-build:\n\tnpm run docker:build\n\ndocker-up:\n\tnpm run docker:up\n\ndocker-down:\n\tnpm run docker:down\n\ndocker-logs:\n\tnpm run docker:logs\n\nclean:\n\trm -rf node_modules dist .astro\n\tnpm cache clean --force