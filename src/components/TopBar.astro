---
// TopBar.astro
const { pathname } = Astro.url;
const isHomePage = pathname === '/';
---

<div class="topbar">
  <div class="logo">
    <h1>Placeholder</h1>
  </div>
  
  <div class={`search-container ${isHomePage ? 'hidden' : ''}`} id="topbar-search-container">
    <input 
      id="topbar-search-input"
      type="text" 
      placeholder="Pesquisar..." 
      class="search-input"
    />
  </div>
  
  <nav class="nav-buttons">
    <div class="dropdown-nav">
      <button class="nav-btn dropdown-btn" id="registrosBtn">
        Dedicado
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 10L12 15L17 10H7Z" fill="currentColor"/>
        </svg>
      </button>
      <div class="nav-dropdown" id="registrosDropdown">
        <a href="/empresas" class="dropdown-item">Empresas</a>
        <a href="/maquinas" class="dropdown-item">Máquinas</a>
        <a href="/pessoas" class="dropdown-item">Pessoas</a>
        <a href="/chatbots" class="dropdown-item">Chatbots</a>
      </div>
    </div>
    
    <div class="dropdown-nav">
      <button class="nav-btn dropdown-btn" id="cloudBtn">
        Cloud
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 10L12 15L17 10H7Z" fill="currentColor"/>
        </svg>
      </button>
      <div class="nav-dropdown" id="cloudDropdown">
        <a href="/revenda-cloud" class="dropdown-item">Revendas Cloud</a>
        <a href="/perfil-cloud" class="dropdown-item">Perfis Cloud</a>
        <a href="/contato-cloud" class="dropdown-item">Contatos Cloud</a>
        <a href="/organizacao-cloud" class="dropdown-item">Organizações Cloud</a>
      </div>
    </div>
  </nav>
  
  <div class="user-menu">
    <button class="user-button" id="userButton">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" fill="currentColor"/>
        <path d="M12 14C7.58172 14 4 17.5817 4 22H20C20 17.5817 16.4183 14 12 14Z" fill="currentColor"/>
      </svg>
    </button>
    
    <div class="dropdown" id="dropdown">
      <a href="#" class="dropdown-item">Mais informações</a>
      <a href="#" class="dropdown-item">Sair</a>
    </div>
  </div>
</div>

<style>
  .topbar {
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-primary);
    height: 72px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 var(--space-xl);
    position: sticky;
    top: 0;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    gap: var(--space-lg);
    z-index: 1000;
    box-shadow: var(--shadow-sm);
  }

  .search-container {
    flex: 1;
    max-width: 480px;
    margin: 0 var(--space-lg);
  }

  .search-container.hidden {
    visibility: hidden;
  }

  .search-input {
    width: 100%;
    padding: var(--space-sm) var(--space-lg);
    font-size: 14px;
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    outline: none;
    background: var(--bg-input);
    color: var(--text-primary);
    font-family: inherit;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .search-input::placeholder {
    color: var(--text-placeholder);
  }

  .search-input:focus {
    border-color: var(--accent-primary);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-glow);
    transform: translateY(-1px);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .logo h1 {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    font-size: 24px;
    user-select: none;
    background: var(--gradient-silver-dark);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 30px rgba(192, 192, 192, 0.3);
  }

  .nav-buttons {
    display: flex;
    gap: var(--space-sm);
  }

  .dropdown-nav {
    position: relative;
  }

  .dropdown-btn {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.95);
    transition: all var(--transition-fast);
    z-index: 9999;
    overflow: hidden;
  }

  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 20px;
    width: 12px;
    height: 12px;
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-bottom: none;
    border-right: none;
    transform: rotate(45deg);
  }

  .nav-dropdown.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .nav-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    color: var(--text-secondary);
    font-size: 14px;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    user-select: none;
    position: relative;
    overflow: hidden;
  }

  .nav-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(192, 192, 192, 0.1), transparent);
    transition: left var(--transition-normal);
  }

  .nav-btn:hover {
    background: var(--bg-hover);
    border-color: var(--silver-muted);
    color: var(--silver-light);
    transform: translateY(-1px);
    box-shadow: var(--shadow-silver);
  }

  .nav-btn:hover::before {
    left: 100%;
  }

  .nav-btn:active {
    transform: translateY(0);
  }

  .user-menu {
    position: relative;
  }

  .user-button {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    width: 40px;
    height: 40px;
  }

  .user-button:hover {
    background: var(--bg-hover);
    border-color: var(--silver-muted);
    color: var(--silver-light);
    transform: translateY(-1px);
    box-shadow: var(--shadow-silver);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.95);
    transition: all var(--transition-fast);
    z-index: 9999;
    overflow: hidden;
  }

  .dropdown::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 12px;
    width: 12px;
    height: 12px;
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-bottom: none;
    border-right: none;
    transform: rotate(45deg);
  }

  .dropdown.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .dropdown-item {
    display: block;
    padding: var(--space-sm) var(--space-md);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-family: inherit;
    transition: all var(--transition-fast);
    position: relative;
    border-bottom: 1px solid var(--border-primary);
  }

  .dropdown-item:last-child {
    border-bottom: none;
  }

  .dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--silver-light);
    padding-left: calc(var(--space-md) + 4px);
  }

  .dropdown-item:first-child {
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .dropdown-item:last-child {
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .topbar {
      padding: 0 var(--space-md);
      height: 64px;
    }
    
    .logo h1 {
      font-size: 20px;
    }
    
    .nav-buttons {
      gap: var(--space-xs);
    }
    
    .nav-btn {
      padding: var(--space-xs) var(--space-sm);
      font-size: 13px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const userButton = document.getElementById('userButton');
    const dropdown = document.getElementById('dropdown');
    const searchInput = document.getElementById('topbar-search-input');
    const registrosBtn = document.getElementById('registrosBtn');
    const registrosDropdown = document.getElementById('registrosDropdown');
    const cloudBtn = document.getElementById('cloudBtn');
    const cloudDropdown = document.getElementById('cloudDropdown');

    // Dropdown de usuário
    userButton?.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown?.classList.toggle('show');
      registrosDropdown?.classList.remove('show');
      cloudDropdown?.classList.remove('show');
    });

    // Dropdown de registros
    registrosBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      registrosDropdown?.classList.toggle('show');
      dropdown?.classList.remove('show');
      cloudDropdown?.classList.remove('show');
    });

    // Dropdown de cloud
    cloudBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      cloudDropdown?.classList.toggle('show');
      dropdown?.classList.remove('show');
      registrosDropdown?.classList.remove('show');
    });

    // Fechar dropdowns ao clicar fora
    document.addEventListener('click', () => {
      dropdown?.classList.remove('show');
      registrosDropdown?.classList.remove('show');
      cloudDropdown?.classList.remove('show');
    });

    // Prevenir fechamento ao clicar dentro dos dropdowns
    [dropdown, registrosDropdown, cloudDropdown].forEach(el => {
      el?.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });

    // Funcionalidade de pesquisa
    searchInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        const query = e.target.value.trim();
        if (query) {
          window.location.href = `/?search=${encodeURIComponent(query)}`;
        }
      }
    });
  });
</script>