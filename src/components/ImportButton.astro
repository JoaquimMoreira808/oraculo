---
interface Props {
  text: string;
  id?: string;
}

const { text, id } = Astro.props;
---

<button class="import-btn" id={id}>Importar {text}</button>

<style>
  .import-btn {
    background: #28a745;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-family: 'Arimo', sans-serif;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    margin-left: 10px;
  }

  .import-btn:hover {
    background: #218838;
  }

  .import-btn:active {
    transform: scale(0.95);
  }
</style>