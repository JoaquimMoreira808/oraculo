---
export interface SearchResult {
  empresa: {
    id: number;
    nome: string;
    razao: string;
  };
  matches: Array<{
    table: string;
    field: string;
    value: string;
    entityId: number;
  }>;
}

export interface Props {
  results: SearchResult[];
  isVisible: boolean;
  onClose: () => void;
}

const { results, isVisible, onClose } = Astro.props;

const tableLabels = {
  empresa: 'Empresa',
  maquina: 'Máquina',
  equipamento: 'Equipamento',
  pessoa: 'Pessoa',
  contato: 'Contato',
  chatbot: 'Chatbot',
  numerobot: 'Número Bot',
  rede: 'Rede',
  linha: 'Linha',
  senha: 'Senha',
  tronco: 'Tronco'
};

const fieldLabels = {
  nome: 'Nome',
  razao: 'Razão Social',
  cnpj: 'CNPJ',
  cidade: 'Cidade',
  telefone: 'Telefone',
  email: 'Email',
  ip: 'IP',
  vpn: 'VPN',
  operacao: 'Operação',
  local: 'Local'
};
---

{isVisible && (
  <div class="search-results-overlay" onclick={onClose}>
    <div class="search-results" onclick="event.stopPropagation()">
      <div class="search-header">
        <h3>Resultados da Busca</h3>
        <button class="close-btn" onclick={onClose}>×</button>
      </div>
      
      {results.length > 0 && (
        <div class="results-count">
          {results.length} {results.length === 1 ? 'empresa encontrada' : 'empresas encontradas'}
        </div>
      )}
      
      <div class="results-container">
        {results.length === 0 ? (
          <div class="no-results">
            <p>Nenhum resultado encontrado</p>
          </div>
        ) : (
          results.map((result) => (
            <div class="empresa-result">
              <div class="empresa-header">
                <h4>{result.empresa.nome}</h4>
                <span class="empresa-razao">{result.empresa.razao}</span>
              </div>
              
              <div class="matches">
                {result.matches.map((match) => (
                  <div class="match-item">
                    <span class="match-table">
                      {tableLabels[match.table] || match.table}
                    </span>
                    <span class="match-field">
                      {fieldLabels[match.field] || match.field}:
                    </span>
                    <span class="match-value">{match.value}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
)}

<style>
  .search-results-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 20px;
    z-index: 1000;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideIn {
    from { 
      opacity: 0;
      transform: translateY(-20px) scale(0.95);
    }
    to { 
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-results {
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15), 0 8px 32px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 700px;
    max-height: 85vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: slideIn 0.3s ease-out;
    margin-top: 60px;
  }

  .search-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 28px;
    border-bottom: 1px solid #e8eaed;
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    position: relative;
  }

  .search-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #007acc, #0099ff, #007acc);
    background-size: 200% 100%;
    animation: shimmer 2s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .search-header h3 {
    margin: 0;
    color: #1a1a1a;
    font-size: 20px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .search-header h3::before {
    content: '🔍';
    font-size: 18px;
  }

  .close-btn {
    background: #f1f3f4;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #5f6368;
    padding: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s ease;
    font-weight: 300;
  }

  .close-btn:hover {
    background: #e8eaed;
    color: #202124;
    transform: scale(1.05);
  }

  .results-container {
    overflow-y: auto;
    padding: 0;
    flex: 1;
    background: #fafbfc;
  }

  .results-container::-webkit-scrollbar {
    width: 6px;
  }

  .results-container::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  .results-container::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
  }

  .results-container::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
  }

  .no-results {
    text-align: center;
    padding: 60px 20px;
    color: #5f6368;
    font-size: 16px;
  }

  .no-results::before {
    content: '🤷‍♂️';
    display: block;
    font-size: 48px;
    margin-bottom: 16px;
  }

  .empresa-result {
    margin: 0;
    padding: 24px 28px;
    border-bottom: 1px solid #e8eaed;
    background: white;
    transition: all 0.2s ease;
    position: relative;
  }

  .empresa-result:hover {
    background: #f8f9fa;
    box-shadow: inset 4px 0 0 #007acc;
  }

  .empresa-result:last-child {
    border-bottom: none;
  }

  .empresa-header {
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0f0f0;
  }

  .empresa-header h4 {
    margin: 0 0 6px 0;
    color: #007acc;
    font-size: 18px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .empresa-header h4::before {
    content: '🏢';
    font-size: 16px;
  }

  .empresa-razao {
    color: #5f6368;
    font-size: 14px;
    font-style: italic;
    margin-left: 24px;
  }

  .matches {
    display: grid;
    gap: 12px;
  }

  .match-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    border-radius: 10px;
    border: 1px solid #e8eaed;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .match-item:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 122, 204, 0.15);
    border-color: #007acc;
  }

  .match-table {
    background: linear-gradient(135deg, #007acc 0%, #0099ff 100%);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-width: fit-content;
    box-shadow: 0 2px 8px rgba(0, 122, 204, 0.3);
    position: relative;
  }

  .match-table::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s;
  }

  .match-item:hover .match-table::before {
    left: 100%;
  }

  .match-field {
    color: #5f6368;
    font-size: 13px;
    font-weight: 500;
    min-width: fit-content;
    text-transform: capitalize;
  }

  .match-value {
    color: #202124;
    font-weight: 600;
    font-size: 14px;
    background: linear-gradient(135deg, #e8f0fe 0%, #f8f9fa 100%);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #e8eaed;
    flex: 1;
    word-break: break-word;
  }

  .results-count {
    padding: 12px 28px;
    background: #e8f0fe;
    color: #1967d2;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 1px solid #e8eaed;
  }

  @media (max-width: 768px) {
    .search-results-overlay {
      padding: 10px;
    }

    .search-results {
      width: 100%;
      max-height: 90vh;
      margin-top: 20px;
      border-radius: 12px;
    }

    .search-header {
      padding: 20px;
    }

    .search-header h3 {
      font-size: 18px;
    }

    .empresa-result {
      padding: 20px;
    }

    .match-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 16px;
    }

    .match-table {
      align-self: flex-start;
    }

    .match-value {
      width: 100%;
      margin-top: 4px;
    }
  }
</style>