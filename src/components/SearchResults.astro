---
export interface SearchResult {
  empresa: {
    id: number;
    nome: string;
    razao: string;
  };
  matches: Array<{
    table: string;
    field: string;
    value: string;
    entityId: number;
  }>;
}

export interface Props {
  results: SearchResult[];
  isVisible: boolean;
  onClose: () => void;
}

const { results, isVisible, onClose } = Astro.props;

const tableLabels = {
  empresa: 'Empresa',
  maquina: 'Máquina',
  equipamento: 'Equipamento',
  pessoa: 'Pessoa',
  contato: 'Contato',
  chatbot: 'Chatbot',
  numerobot: 'Número Bot',
  rede: 'Rede',
  linha: 'Linha',
  senha: 'Senha',
  tronco: 'Tronco'
};

const fieldLabels = {
  nome: 'Nome',
  razao: 'Razão Social',
  cnpj: 'CNPJ',
  cidade: 'Cidade',
  telefone: 'Telefone',
  email: 'Email',
  ip: 'IP',
  vpn: 'VPN',
  operacao: 'Operação',
  local: 'Local'
};
---

{isVisible && (
  <div class="search-results-overlay" onclick={onClose}>
    <div class="search-results" onclick="event.stopPropagation()">
      <div class="search-header">
        <h3>Resultados da Busca</h3>
        <button class="close-btn" onclick={onClose}>×</button>
      </div>
      
      {results.length > 0 && (
        <div class="results-count">
          {results.length} {results.length === 1 ? 'empresa encontrada' : 'empresas encontradas'}
        </div>
      )}
      
      <div class="results-container">
        {results.length === 0 ? (
          <div class="no-results">
            <p>Nenhum resultado encontrado</p>
          </div>
        ) : (
          results.map((result) => (
            <div class="empresa-result">
              <h4 class="record-name">{result.empresa.nome}</h4>
              <span class="record-type">Empresa</span>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
)}

<style>
  .search-results-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: var(--space-lg);
    z-index: 1000;
    animation: fadeIn 0.4s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideIn {
    from { 
      opacity: 0;
      transform: translateY(-20px) scale(0.97);
    }
    to { 
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-results {
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    width: 100%;
    max-width: 1200px;
    max-height: 85vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: slideIn 0.4s ease-out;
    margin-top: 60px;
    font-family: 'Inter', sans-serif;
    backdrop-filter: blur(10px);
  }

  .search-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl);
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-elevated);
    position: relative;
  }

  .search-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-primary);
  }

  .search-header h3 {
    margin: 0;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
  }

  .close-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    font-size: 20px;
    cursor: pointer;
    color: var(--text-muted);
    padding: var(--space-sm);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    font-weight: 300;
  }

  .close-btn:hover {
    background: var(--error-bg);
    border-color: var(--error);
    color: var(--error);
    transform: scale(1.05);
  }

  .results-container {
    overflow-y: auto;
    padding: 0;
    flex: 1;
    background: var(--bg-card);
  }

  /* Aplicar scrollbar personalizada para resultados */
  .results-container::-webkit-scrollbar {
    width: 6px;
  }

  .results-container::-webkit-scrollbar-track {
    background: var(--bg-elevated);
    border-radius: 3px;
    margin: 2px;
  }

  .results-container::-webkit-scrollbar-thumb {
    background: var(--border-primary);
    border-radius: 3px;
    transition: all var(--transition-fast);
  }

  .results-container::-webkit-scrollbar-thumb:hover {
    background: var(--accent-primary);
    box-shadow: 0 0 6px rgba(59, 130, 246, 0.3);
  }

  .no-results {
    text-align: center;
    padding: 40px 20px;
    color: #666666;
    font-size: 16px;
    font-family: 'Arimo', sans-serif;
  }

  .no-results::before {
    content: '🤷‍♂️';
    display: block;
    font-size: 48px;
    margin-bottom: 16px;
  }

  .empresa-result {
    padding: var(--space-xl);
    border-bottom: 1px solid var(--border-primary);
    background: var(--bg-card);
    transition: all var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  .empresa-result::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: transparent;
    transition: background var(--transition-fast);
  }

  .empresa-result:hover {
    background: var(--bg-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .empresa-result:hover::before {
    background: var(--accent-primary);
  }

  .empresa-result:last-child {
    border-bottom: none;
  }

  .record-name {
    margin: 0 0 var(--space-xs) 0;
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    transition: color var(--transition-fast);
  }

  .record-type {
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background: var(--bg-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-primary);
  }

  .results-count {
    padding: var(--space-md) var(--space-xl);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    border-top: 1px solid var(--border-primary);
    text-align: center;
    font-family: 'Inter', sans-serif;
  }

  @media (max-width: 768px) {
    .search-results-overlay {
      padding: var(--space-md);
    }

    .search-results {
      width: 100%;
      max-height: 90vh;
      margin-top: var(--space-lg);
      border-radius: var(--radius-lg);
    }

    .search-header {
      padding: var(--space-lg);
    }

    .search-header h3 {
      font-size: 18px;
    }

    .empresa-result {
      padding: var(--space-lg);
    }
  }
</style>