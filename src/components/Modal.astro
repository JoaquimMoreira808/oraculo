---
interface Props {
  id: string;
  title: string;
  formId: string;
}

const { id, title, formId } = Astro.props;
---

<div id={id} class="modal">
  <div class="modal-content">
    <button class="modal-close" data-close-modal={id}>&times;</button>
    <h2 class="modal-title">{title}</h2>
    
    <form id={formId}>
      <slot />
      
      <div class="form-actions">
        <button type="button" class="btn-cancel" data-close-modal={id}>Cancelar</button>
        <button type="submit" class="btn-save">Salvar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .modal.show {
    display: flex;
    opacity: 1;
  }

  .modal.closing {
    opacity: 0;
  }

  .modal-content {
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 85vh;
    overflow-y: auto;
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-xl);
  }

  /* Aplicar scrollbar personalizada para modais */
  .modal-content::-webkit-scrollbar {
    width: 4px;
  }

  .modal-content::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 2px;
  }

  .modal-content::-webkit-scrollbar-thumb {
    background: var(--text-disabled);
    border-radius: 2px;
    transition: all var(--transition-fast);
    opacity: 0.6;
  }

  .modal-content::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
    opacity: 1;
  }

  .modal.show .modal-content {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .modal.closing .modal-content {
    transform: scale(0.95) translateY(20px);
    opacity: 0;
  }

  .modal-close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    font-size: 20px;
    color: var(--text-muted);
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .modal-close:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .modal-title {
    margin: 0 0 var(--space-xl) 0;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 24px;
    font-weight: 600;
  }

  :global(.form-group) {
    margin-bottom: var(--space-lg);
  }

  :global(.form-group label) {
    display: block;
    margin-bottom: var(--space-xs);
    color: var(--text-primary);
    font-weight: 500;
    font-family: inherit;
    font-size: 14px;
  }

  :global(.form-group input),
  :global(.form-group textarea),
  :global(.form-group select) {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 14px;
    box-sizing: border-box;
    background: var(--bg-input) !important;
    color: var(--text-primary) !important;
    transition: all var(--transition-fast);
  }

  :global(.form-group input::placeholder),
  :global(.form-group textarea::placeholder) {
    color: var(--text-placeholder);
  }

  :global(.form-group input:focus),
  :global(.form-group textarea:focus),
  :global(.form-group select:focus) {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-bg);
    background: var(--bg-elevated);
  }

  :global(.form-group input::-webkit-autofill),
  :global(.form-group textarea::-webkit-autofill),
  :global(.form-group select::-webkit-autofill) {
    -webkit-box-shadow: 0 0 0 1000px var(--bg-input) inset !important;
    -webkit-text-fill-color: var(--text-primary) !important;
    border-color: var(--border-primary) !important;
    background-color: var(--bg-input) !important;
    transition: background-color 5000s ease-in-out 0s !important;
    background-image: none !important;
    background-clip: padding-box !important;
  }

  :global(.form-group input::-webkit-autofill:focus),
  :global(.form-group textarea::-webkit-autofill:focus),
  :global(.form-group select::-webkit-autofill:focus) {
    -webkit-box-shadow: 0 0 0 1000px var(--bg-elevated) inset !important;
    border-color: var(--accent-primary) !important;
    box-shadow: 0 0 0 3px var(--accent-bg), 0 0 0 1000px var(--bg-elevated) inset !important;
  }

  .form-actions {
    display: flex;
    gap: var(--space-sm);
    justify-content: flex-end;
    margin-top: var(--space-xl);
  }

  .btn-cancel {
    background: var(--bg-elevated);
    color: var(--text-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-lg);
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .btn-cancel:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .btn-save {
    background: var(--gradient-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-lg);
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .btn-save:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }

  .btn-save:active {
    transform: translateY(0);
  }
</style>