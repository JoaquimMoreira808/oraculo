---
interface Props {
  itemId: number;
  onView?: string;
}

const { itemId, onView = '' } = Astro.props;
---

<button class="view-btn" title="Ver detalhes" data-item-id={itemId} data-on-view={onView}>
  <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 10C2 10 6.5 4 12 4C17.5 4 22 10 22 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M2 14C2 14 6.5 20 12 20C17.5 20 22 14 22 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
  <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 12C2 12 6.5 6 12 6C17.5 6 22 12 22 12C22 12 17.5 18 12 18C6.5 18 2 12 2 12Z" stroke="currentColor" stroke-width="2"/>
    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
  </svg>
</button>

<style>
  .view-btn {
    background: rgba(24, 48, 84, 0.1);
    color: #183054;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 34px;
    height: 30px;
  }

  .view-btn:hover {
    background: rgba(24, 48, 84, 0.2);
  }

  .view-btn:active {
    transform: scale(0.95);
  }

  .eye-closed,
  .eye-open {
    position: absolute;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .eye-closed {
    opacity: 1;
    transform: scale(0.85);
  }

  .eye-open {
    opacity: 0;
    transform: scale(1);
  }

  .view-btn:hover .eye-closed {
    opacity: 0;
    transform: scale(0.85);
  }

  .view-btn:hover .eye-open {
    opacity: 1;
    transform: scale(1);
  }
</style>
