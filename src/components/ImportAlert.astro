---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="alert-overlay">
  <div class="alert-content">
    <div class="alert-header">
      <h3 id="alertTitle">Resultado da Importação</h3>
      <button class="alert-close" data-close-alert>&times;</button>
    </div>
    
    <div class="alert-body">
      <div class="alert-content" id="alertContent"></div>
    </div>
    
    <div class="alert-actions">
      <button class="btn-alert-ok" data-close-alert>OK</button>
    </div>
  </div>
</div>

<style>
  .alert-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 3000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .alert-overlay.show {
    display: flex;
    opacity: 1;
  }

  .alert-overlay.closing {
    opacity: 0;
  }

  .alert-content {
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    max-width: 600px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    position: relative;
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-xl);
  }

  .alert-overlay.show .alert-content {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .alert-overlay.closing .alert-content {
    transform: scale(0.95) translateY(20px);
    opacity: 0;
  }

  .alert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl) var(--space-xl) 0 var(--space-xl);
    border-bottom: 1px solid var(--border-primary);
    margin-bottom: var(--space-lg);
  }

  .alert-header h3 {
    margin: 0;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 20px;
    font-weight: 600;
  }

  .alert-close {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    font-size: 20px;
    color: var(--text-muted);
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .alert-close:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .alert-body {
    padding: 0 var(--space-xl) var(--space-lg) var(--space-xl);
    text-align: center;
  }

  .alert-content {
    padding: var(--space-lg);
  }

  :global(.error-title) {
    font-size: 24px;
    color: var(--error);
    font-family: inherit;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  :global(.error-message) {
    font-size: 14px;
    color: var(--text-secondary);
    font-family: inherit;
    line-height: 1.5;
  }

  :global(.success-title) {
    font-size: 24px;
    color: var(--success);
    font-family: inherit;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  :global(.success-message) {
    font-size: 14px;
    color: var(--text-secondary);
    font-family: inherit;
    line-height: 1.5;
  }

  .alert-actions {
    padding: 0 var(--space-xl) var(--space-xl) var(--space-xl);
    text-align: center;
  }

  .btn-alert-ok {
    background: var(--success);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-xl);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .btn-alert-ok:hover {
    background: #16a34a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
  }

  .btn-alert-ok:active {
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const alertOverlay = document.getElementById('importAlert');
    
    window.showImportAlert = function(result) {
      const alertContent = document.getElementById('alertContent');
      
      if (result.success) {
        alertContent.innerHTML = `
          <div class="success-title">Sucesso!</div>
          <div class="success-message">${result.success} registros importados.</div>
        `;
      } else {
        const errorMessage = result.error.replace(/^Linha \d+: /, '');
        const capitalizedError = errorMessage.charAt(0).toUpperCase() + errorMessage.slice(1);
        alertContent.innerHTML = `
          <div class="error-title">Ops!</div>
          <div class="error-message">${capitalizedError}</div>
        `;
      }
      
      alertOverlay.style.display = 'flex';
      alertOverlay.offsetHeight;
      alertOverlay.classList.add('show');
    };
    
    document.addEventListener('click', (e) => {
      if (e.target.matches('[data-close-alert]')) {
        alertOverlay.classList.add('closing');
        setTimeout(() => {
          alertOverlay.classList.remove('show', 'closing');
          alertOverlay.style.display = 'none';
        }, 300);
      }
    });
    
    alertOverlay.addEventListener('click', (e) => {
      if (e.target === alertOverlay) {
        alertOverlay.classList.add('closing');
        setTimeout(() => {
          alertOverlay.classList.remove('show', 'closing');
          alertOverlay.style.display = 'none';
        }, 300);
      }
    });
  });
</script>