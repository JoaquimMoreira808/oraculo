---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="alert-overlay">
  <div class="alert-content">
    <div class="alert-header">
      <h3 id="alertTitle">Resultado da Importação</h3>
      <button class="alert-close" data-close-alert>&times;</button>
    </div>
    
    <div class="alert-body">
      <div class="alert-content" id="alertContent"></div>
    </div>
    
    <div class="alert-actions">
      <button class="btn-alert-ok" data-close-alert>OK</button>
    </div>
  </div>
</div>

<style>
  .alert-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 3000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .alert-overlay.show {
    display: flex;
    opacity: 1;
  }

  .alert-overlay.closing {
    opacity: 0;
  }

  .alert-content {
    background: white;
    border-radius: 8px;
    max-width: 600px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    position: relative;
    transform: scale(0.9);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .alert-overlay.show .alert-content {
    transform: scale(1);
    opacity: 1;
  }

  .alert-overlay.closing .alert-content {
    transform: scale(0.9);
    opacity: 0;
  }

  .alert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px 0 24px;
    border-bottom: 1px solid #e9ecef;
    margin-bottom: 20px;
  }

  .alert-header h3 {
    margin: 0;
    color: #333;
    font-family: 'Arimo', sans-serif;
    font-size: 20px;
  }

  .alert-close {
    background: none;
    border: none;
    font-size: 24px;
    color: #666;
    cursor: pointer;
    width: 32px;
    height: 32px;
  }

  .alert-close:hover {
    color: #333;
  }

  .alert-body {
    padding: 0 24px 20px 24px;
    text-align: center;
  }

  .alert-content {
    padding: 20px;
  }

  :global(.error-title) {
    font-size: 24px;
    color: #666;
    font-family: 'Arimo', sans-serif;
    font-weight: 600;
    margin-bottom: 12px;
  }

  :global(.error-message) {
    font-size: 14px;
    color: #333;
    font-family: 'Arimo', sans-serif;
  }

  :global(.success-title) {
    font-size: 24px;
    color: #28a745;
    font-family: 'Arimo', sans-serif;
    font-weight: 600;
    margin-bottom: 12px;
  }

  :global(.success-message) {
    font-size: 14px;
    color: #333;
    font-family: 'Arimo', sans-serif;
  }

  .alert-actions {
    padding: 0 24px 24px 24px;
    text-align: center;
  }

  .btn-alert-ok {
    background: #28a745;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-family: 'Arimo', sans-serif;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-alert-ok:hover {
    background: #218838;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const alertOverlay = document.getElementById('importAlert');
    
    window.showImportAlert = function(result) {
      const alertContent = document.getElementById('alertContent');
      
      if (result.success) {
        alertContent.innerHTML = `
          <div class="success-title">Sucesso!</div>
          <div class="success-message">${result.success} registros importados.</div>
        `;
      } else {
        const errorMessage = result.error.replace(/^Linha \d+: /, '');
        const capitalizedError = errorMessage.charAt(0).toUpperCase() + errorMessage.slice(1);
        alertContent.innerHTML = `
          <div class="error-title">Ops!</div>
          <div class="error-message">${capitalizedError}</div>
        `;
      }
      
      alertOverlay.style.display = 'flex';
      alertOverlay.offsetHeight;
      alertOverlay.classList.add('show');
    };
    
    document.addEventListener('click', (e) => {
      if (e.target.matches('[data-close-alert]')) {
        alertOverlay.classList.add('closing');
        setTimeout(() => {
          alertOverlay.classList.remove('show', 'closing');
          alertOverlay.style.display = 'none';
        }, 300);
      }
    });
    
    alertOverlay.addEventListener('click', (e) => {
      if (e.target === alertOverlay) {
        alertOverlay.classList.add('closing');
        setTimeout(() => {
          alertOverlay.classList.remove('show', 'closing');
          alertOverlay.style.display = 'none';
        }, 300);
      }
    });
  });
</script>