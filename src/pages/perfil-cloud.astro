---
import TopBar from '../components/TopBar.astro';
import Layout from '../layouts/Layout.astro';
import DataTable from '../components/DataTable.astro';
import ViewButton from '../components/ViewButton.astro';
import EditButton from '../components/EditButton.astro';
import DeleteButton from '../components/DeleteButton.astro';
import AddButton from '../components/AddButton.astro';
import ImportButton from '../components/ImportButton.astro';
import Modal from '../components/Modal.astro';
import ImportModal from '../components/ImportModal.astro';
import ImportAlert from '../components/ImportAlert.astro';
import FormField from '../components/FormField.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import SelectField from '../components/SelectField.astro';
import { fetchPaginatedData, fetchApiData } from '../lib/api.js';

export const prerender = false;

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 10;

const [perfilsResult, revendas] = await Promise.all([
  fetchPaginatedData('perfil-cloud', page, limit),
  fetchApiData('revenda-cloud')
]);

const { data: perfils, pagination } = perfilsResult;
---

<Layout>
  <TopBar />
  <main>
    <div class="header">
      <h1 class="page-title">Perfis Cloud</h1>
      <div class="header-buttons">
        <AddButton text="Novo Perfil" id="addPerfilBtn" />
        <ImportButton text="Perfis" id="importPerfilBtn" />
      </div>
    </div>
    
    <DataTable 
      columns={['Nome', 'Revenda']} 
      data={perfils}
      pagination={pagination}
      entityName="perfil-cloud"
    >
      {perfils.map((perfil) => (
        <tr>
          <td>{perfil.nome}</td>
          <td>{perfil.revenda_nome || '-'}</td>
          <td>
            <div class="action-buttons">
              <ViewButton itemId={perfil.id} />
              <EditButton itemId={perfil.id} />
              <DeleteButton itemId={perfil.id} />
            </div>
          </td>
        </tr>
      ))}
    </DataTable>
  </main>

  <Modal id="perfilModal" title="Novo Perfil" formId="perfilForm">
    <FormField label="Nome" name="nome" required />
    <SelectField 
      label="Revenda Cloud" 
      name="revendacloud_id" 
      required 
      options={revendas.map(r => ({value: r.id, text: r.nome_fantasia}))}
    />
  </Modal>

  <ConfirmModal 
    id="confirmModal" 
    title="Tem certeza que deseja excluir este perfil?" 
    warning="Esse arquivo será perdido pra sempre! (Muito tempo)"
    confirmText="Excluir"
  />

  <ImportModal id="importModal" title="Importar Perfis" templateUrl="/templates/perfil_cloud_template.csv" importType="perfil-cloud" />

  <ImportAlert id="importAlert" />

  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-details>&times;</button>
      <h2 id="modalTitle">Detalhes do Perfil</h2>
      
      <div class="details-stack">
        <div class="detail-item" id="nomeText"></div>
        <div class="detail-item" id="revendaText"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  main {
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
    animation: fadeInScale 0.4s ease-out;
    position: relative;
    z-index: 1;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .header-buttons {
    display: flex;
    align-items: center;
  }

  .page-title {
    margin: 0;
    color: #333;
    font-size: 28px;
    font-weight: 600;
    font-family: 'Arimo', sans-serif;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .modal.show {
    display: flex;
    opacity: 1;
  }

  .modal.closing {
    opacity: 0;
  }

  .modal-content {
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 85vh;
    overflow-y: auto;
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-xl);
  }

  .modal.show .modal-content {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .modal.closing .modal-content {
    transform: scale(0.95) translateY(20px);
    opacity: 0;
  }

  .modal-close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    font-size: 20px;
    color: var(--text-muted);
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .modal-close:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  #modalTitle {
    margin: 0 0 var(--space-xl) 0;
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 24px;
    font-weight: 600;
  }

  .details-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .detail-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    transition: all var(--transition-fast);
  }

  .detail-item:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
  }

  .detail-item p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    font-family: 'Inter', sans-serif;
  }

  .detail-item strong {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('perfilModal');
    const importModal = document.getElementById('importModal');
    const confirmModal = document.getElementById('confirmModal');
    const detailsModal = document.getElementById('detailsModal');
    const addBtn = document.getElementById('addPerfilBtn');
    const importBtn = document.getElementById('importPerfilBtn');
    const form = document.getElementById('perfilForm');
    const modalTitle = modal.querySelector('.modal-title');
    const saveBtn = modal.querySelector('.btn-save');
    
    let isEditing = false;
    let editingId = null;
    let deleteId = null;

    const urlParams = new URLSearchParams(window.location.search);
    const viewId = urlParams.get('view');
    if (viewId) {
      setTimeout(() => showDetails(viewId), 100);
    }

    function reloadWithoutAnimation() {
      if (window.reloadWithoutAnimation) {
        window.reloadWithoutAnimation();
      } else {
        window.location.reload();
      }
    }

    addBtn.addEventListener('click', () => {
      isEditing = false;
      editingId = null;
      modalTitle.textContent = 'Novo Perfil';
      saveBtn.textContent = 'Salvar';
      form.reset();
      modal.style.display = 'flex';
      modal.offsetHeight;
      modal.classList.add('show');
    });

    importBtn.addEventListener('click', () => {
      importModal.style.display = 'flex';
      importModal.offsetHeight;
      importModal.classList.add('show');
    });

    document.addEventListener('click', (e) => {
      if (e.target.closest('.delete-btn')) {
        const btn = e.target.closest('.delete-btn');
        deleteId = btn.getAttribute('data-item-id');
        confirmModal.classList.add('show');
      }
      if (e.target.closest('.view-btn')) {
        const btn = e.target.closest('.view-btn');
        const id = btn.getAttribute('data-item-id');
        showDetails(id);
      }
    });

    document.addEventListener('click', (e) => {
      if (e.target.matches('[data-close-modal="perfilModal"]')) {
        closeModal();
      }
      if (e.target.matches('[data-confirm-cancel="confirmModal"]')) {
        closeConfirmModal();
      }
      if (e.target.matches('[data-confirm-action="confirmModal"]')) {
        confirmDelete();
      }
      if (e.target.matches('[data-close-details]')) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function confirmDelete() {
      try {
        const response = await fetch(`http://localhost:3000/api/perfil-cloud/${deleteId}`, {
          method: 'DELETE'
        });
        
        if (response.ok) {
          confirmModal.classList.add('closing');
          setTimeout(() => {
            confirmModal.classList.remove('show', 'closing');
            reloadWithoutAnimation();
          }, 300);
        } else {
          alert('Erro ao excluir perfil');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    }

    function closeConfirmModal() {
      confirmModal.classList.add('closing');
      setTimeout(() => {
        confirmModal.classList.remove('show', 'closing');
        deleteId = null;
      }, 300);
    }

    function closeModal() {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.classList.remove('show', 'closing');
        modal.style.display = 'none';
        form.reset();
        isEditing = false;
        editingId = null;
      }, 300);
    }

    document.addEventListener('click', async (e) => {
      if (e.target.closest('.edit-btn')) {
        const btn = e.target.closest('.edit-btn');
        const id = btn.getAttribute('data-item-id');
        
        try {
          const response = await fetch(`http://localhost:3000/api/perfil-cloud/${id}`);
          const perfil = await response.json();
          
          isEditing = true;
          editingId = id;
          modalTitle.textContent = 'Editar Perfil';
          saveBtn.textContent = 'Atualizar';
          
          form.nome.value = perfil.nome || '';
          form.revendacloud_id.value = perfil.revendacloud_id || '';
          
          modal.style.display = 'flex';
          modal.offsetHeight;
          modal.classList.add('show');
        } catch (error) {
          alert('Erro ao carregar dados do perfil');
        }
      }
    });
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    confirmModal.addEventListener('click', (e) => {
      if (e.target === confirmModal) closeConfirmModal();
    });

    detailsModal.addEventListener('click', (e) => {
      if (e.target === detailsModal) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function showDetails(id) {
      try {
        const response = await fetch(`http://localhost:3000/api/perfil-cloud/${id}`);
        const perfil = await response.json();
        
        // Buscar dados da revenda
        const revendaResponse = await fetch(`http://localhost:3000/api/revenda-cloud/${perfil.revendacloud_id}`);
        const revenda = await revendaResponse.json();
        
        document.getElementById('modalTitle').textContent = `Detalhes - ${perfil.nome}`;
        
        document.getElementById('nomeText').innerHTML = `<p><strong>Nome:</strong> ${perfil.nome}</p>`;
        document.getElementById('revendaText').innerHTML = `<p><strong>Revenda:</strong> ${revenda.nome_fantasia || 'N/A'}</p>`;
        
        detailsModal.style.display = 'flex';
        detailsModal.offsetHeight;
        detailsModal.classList.add('show');
      } catch (error) {
        alert('Erro ao carregar detalhes');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      try {
        const url = isEditing 
          ? `http://localhost:3000/api/perfil-cloud/${editingId}`
          : 'http://localhost:3000/api/perfil-cloud';
        
        const method = isEditing ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          closeModal();
          reloadWithoutAnimation();
        } else {
          alert('Erro ao salvar perfil');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    });
  });
</script>