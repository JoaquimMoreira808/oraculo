---\nimport Layout from '../layouts/Layout.astro';\nimport DataTable from '../components/DataTable.astro';\nimport TopBar from '../components/TopBar.astro';\n---\n\n<Layout title=\"Perfis Cloud\">\n  <TopBar />\n  <main>\n    <DataTable \n      title=\"Perfis Cloud\"\n      endpoint=\"/api/perfil-cloud\"\n      columns={[\n        { key: 'id', label: 'ID', width: '80px' },\n        { key: 'nome', label: 'Nome', width: '200px' },\n        { key: 'revenda_nome', label: 'Revenda', width: '250px' }\n      ]}\n      fields={[\n        { name: 'nome', label: 'Nome', type: 'text', required: true },\n        { \n          name: 'revendacloud_id', \n          label: 'Revenda Cloud', \n          type: 'select', \n          required: true,\n          endpoint: '/api/revenda-cloud',\n          valueKey: 'id',\n          labelKey: 'nome_fantasia'\n        }\n      ]}\n    />\n  </main>\n</Layout>