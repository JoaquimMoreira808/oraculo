---
import TopBar from '../components/TopBar.astro';
import Layout from '../layouts/Layout.astro';
import DataTable from '../components/DataTable.astro';
import ViewButton from '../components/ViewButton.astro';
import EditButton from '../components/EditButton.astro';
import DeleteButton from '../components/DeleteButton.astro';
import AddButton from '../components/AddButton.astro';
import Modal from '../components/Modal.astro';
import FormField from '../components/FormField.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import { fetchPaginatedData } from '../lib/api.js';

// Forçar página dinâmica
export const prerender = false;

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 10;

console.log('Página solicitada:', page);
console.log('URL completa:', Astro.url.href);

const { data: empresas, pagination } = await fetchPaginatedData('empresas', page, limit);

console.log('Dados retornados:', empresas.length, 'empresas');
console.log('Paginação:', pagination);
---

<Layout>
  <TopBar />
  <main>
    <div class="header">
      <AddButton text="Nova Empresa" id="addEmpresaBtn" />
    </div>
    
    <DataTable 
      columns={['Nome', 'Razão Social', 'CNPJ', 'Cidade', 'Telefone', 'Email']} 
      data={empresas}
      pagination={pagination}
      entityName="empresas"
    >
      {empresas.map((empresa) => (
        <tr>
          <td>{empresa.nome}</td>
          <td>{empresa.razao}</td>
          <td>{empresa.cnpj || '-'}</td>
          <td>{empresa.cidade || '-'}</td>
          <td>{empresa.telefone || '-'}</td>
          <td>{empresa.email || '-'}</td>
          <td>
            <div class="action-buttons">
              <ViewButton itemId={empresa.id} />
              <EditButton itemId={empresa.id} />
              <DeleteButton itemId={empresa.id} />
            </div>
          </td>
        </tr>
      ))}
    </DataTable>
  </main>

  <Modal id="empresaModal" title="Nova Empresa" formId="empresaForm">
    <FormField label="Nome" name="nome" required />
    <FormField label="Razão Social" name="razao" required />
    <FormField label="CNPJ" name="cnpj" />
    <FormField label="Cidade" name="cidade" />
    <FormField label="Telefone" name="telefone" />
    <FormField label="Email" name="email" type="email" />
  </Modal>

  <ConfirmModal 
    id="confirmModal" 
    title="Tem certeza que deseja excluir esta empresa?" 
    warning="Esse arquivo será perdido pra sempre! (Muito tempo)"
    confirmText="Excluir"
  />

  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-details>&times;</button>
      <h2 id="modalTitle">Detalhes da Empresa</h2>
      
      <div class="tabs">
        <button class="tab-btn active" data-tab="detalhes">Detalhes</button>
        <button class="tab-btn" data-tab="chatbots">Chatbots</button>
        <button class="tab-btn" data-tab="maquinas">Máquinas</button>
        <button class="tab-btn" data-tab="pessoas">Pessoas</button>
      </div>

      <div id="detalhes" class="tab-pane active">
        <div class="details-stack">
          <div class="detail-item" id="nomeText"></div>
          <div class="detail-item" id="razaoText"></div>
          <div class="detail-item" id="cnpjText"></div>
          <div class="detail-item" id="cidadeText"></div>
          <div class="detail-item" id="telefoneText"></div>
          <div class="detail-item" id="emailText"></div>
        </div>
      </div>

      <div id="chatbots" class="tab-pane">
        <div id="chatbotsList"></div>
      </div>

      <div id="maquinas" class="tab-pane">
        <div id="maquinasList"></div>
      </div>

      <div id="pessoas" class="tab-pane">
        <div id="pessoasList"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  main {
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
    animation: fadeInScale 0.4s ease-out;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .header {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 24px;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal.show {
    display: flex;
    opacity: 1;
  }

  .modal.closing {
    opacity: 0;
  }

  .modal-content {
    background: white;
    border-radius: 8px;
    padding: 32px;
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 80vh;
    overflow-y: auto;
    transform: scale(0.9);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .modal.show .modal-content {
    transform: scale(1);
    opacity: 1;
  }

  .modal.closing .modal-content {
    transform: scale(0.9);
    opacity: 0;
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    color: #666;
    cursor: pointer;
    width: 32px;
    height: 32px;
  }

  .modal-close:hover {
    color: #333;
  }

  #modalTitle {
    margin: 0 0 24px 0;
    color: #333;
    font-family: 'Arimo', sans-serif;
    font-size: 24px;
  }

  .details-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .detail-item {
    background: white;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 6px;
  }

  .detail-item p {
    margin: 0;
    color: #333;
    font-size: 12px;
    font-family: 'Arimo', sans-serif;
  }

  .tabs {
    display: flex;
    gap: 8px;
    border-bottom: 2px solid #e9ecef;
    margin-bottom: 24px;
  }

  .tab-btn {
    background: none;
    border: none;
    padding: 12px 20px;
    cursor: pointer;
    color: #666;
    font-size: 14px;
    font-family: 'Arimo', sans-serif;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s;
  }

  .tab-btn:hover {
    color: #183054;
  }

  .tab-btn.active {
    color: #183054;
    border-bottom-color: #183054;
    font-weight: 600;
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  :global(.entity-item) {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 8px;
  }

  :global(.entity-info) {
    flex: 1;
  }

  :global(.entity-info h4) {
    margin: 0 0 4px 0;
    color: #333;
    font-size: 14px;
    font-family: 'Arimo', sans-serif;
  }

  :global(.entity-info p) {
    margin: 0 0 8px 0;
    color: #666;
    font-size: 12px;
    font-family: 'Arimo', sans-serif;
  }

  :global(.entity-link) {
    cursor: pointer;
    transition: background-color 0.2s;
  }

  :global(.entity-link:hover) {
    background: #e9ecef;
  }

  :global(.entity-link h4) {
    color: #183054;
    text-decoration: underline;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('empresaModal');
    const confirmModal = document.getElementById('confirmModal');
    const detailsModal = document.getElementById('detailsModal');
    const addBtn = document.getElementById('addEmpresaBtn');
    const form = document.getElementById('empresaForm');
    const modalTitle = modal.querySelector('.modal-title');
    const saveBtn = modal.querySelector('.btn-save');
    
    let isEditing = false;
    let editingId = null;
    let deleteId = null;
    let currentEmpresaId = null;

    // Função para recarregar sem animação
    function reloadWithoutAnimation() {
      if (window.reloadWithoutAnimation) {
        window.reloadWithoutAnimation();
      } else {
        window.location.reload();
      }
    }

    // Abrir modal para criar
    addBtn.addEventListener('click', () => {
      isEditing = false;
      editingId = null;
      modalTitle.textContent = 'Nova Empresa';
      saveBtn.textContent = 'Salvar';
      form.reset();
      modal.style.display = 'flex';
      modal.offsetHeight;
      modal.classList.add('show');
    });

    // Event listeners
    document.addEventListener('click', (e) => {
      if (e.target.closest('.delete-btn')) {
        const btn = e.target.closest('.delete-btn');
        deleteId = btn.getAttribute('data-item-id');
        confirmModal.classList.add('show');
      }
      if (e.target.closest('.view-btn')) {
        const btn = e.target.closest('.view-btn');
        const id = btn.getAttribute('data-item-id');
        showDetails(id);
      }
      if (e.target.matches('.tab-btn')) {
        const tabName = e.target.getAttribute('data-tab');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
        document.getElementById(tabName).classList.add('active');
      }
      if (e.target.closest('.entity-link')) {
        const item = e.target.closest('.entity-link');
        const type = item.getAttribute('data-type');
        const id = item.getAttribute('data-id');
        openEntityDetails(type, id);
      }
    });

    // Event listeners para componentes
    document.addEventListener('click', (e) => {
      // Fechar modal principal
      if (e.target.matches('[data-close-modal="empresaModal"]')) {
        closeModal();
      }
      
      // Fechar modal de confirmação
      if (e.target.matches('[data-confirm-cancel="confirmModal"]')) {
        closeConfirmModal();
      }
      
      // Confirmar exclusão
      if (e.target.matches('[data-confirm-action="confirmModal"]')) {
        confirmDelete();
      }
      
      // Fechar modal de detalhes
      if (e.target.matches('[data-close-details]')) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    // Confirmar exclusão
    async function confirmDelete() {
      try {
        const response = await fetch(`http://localhost:3000/api/empresas/${deleteId}`, {
          method: 'DELETE'
        });
        
        if (response.ok) {
          confirmModal.classList.add('closing');
          setTimeout(() => {
            confirmModal.classList.remove('show', 'closing');
            reloadWithoutAnimation();
          }, 300);
        } else {
          alert('Erro ao excluir empresa');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    }

    // Fechar modal de confirmação
    function closeConfirmModal() {
      confirmModal.classList.add('closing');
      setTimeout(() => {
        confirmModal.classList.remove('show', 'closing');
        deleteId = null;
      }, 300);
    }

    // Fechar modal principal
    function closeModal() {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.classList.remove('show', 'closing');
        modal.style.display = 'none';
        form.reset();
        isEditing = false;
        editingId = null;
      }, 300);
    }

    // Abrir modal para editar
    document.addEventListener('click', async (e) => {
      if (e.target.closest('.edit-btn')) {
        const btn = e.target.closest('.edit-btn');
        const id = btn.getAttribute('data-item-id');
        
        try {
          const response = await fetch(`http://localhost:3000/api/empresas/${id}`);
          const empresa = await response.json();
          
          isEditing = true;
          editingId = id;
          modalTitle.textContent = 'Editar Empresa';
          saveBtn.textContent = 'Atualizar';
          
          // Preencher formulário
          form.nome.value = empresa.nome || '';
          form.razao.value = empresa.razao || '';
          form.cnpj.value = empresa.cnpj || '';
          form.cidade.value = empresa.cidade || '';
          form.telefone.value = empresa.telefone || '';
          form.email.value = empresa.email || '';
          
          modal.style.display = 'flex';
          modal.offsetHeight;
          modal.classList.add('show');
        } catch (error) {
          alert('Erro ao carregar dados da empresa');
        }
      }
    });
    
    // Fechar modais clicando fora
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    confirmModal.addEventListener('click', (e) => {
      if (e.target === confirmModal) closeConfirmModal();
    });

    detailsModal.addEventListener('click', (e) => {
      if (e.target === detailsModal) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function showDetails(id) {
      try {
        currentEmpresaId = id;
        const response = await fetch(`http://localhost:3000/api/empresas/${id}`);
        const empresa = await response.json();
        document.getElementById('modalTitle').textContent = `Detalhes - ${empresa.nome}`;
        
        document.getElementById('nomeText').innerHTML = `<p><strong>Nome:</strong> ${empresa.nome}</p>`;
        document.getElementById('razaoText').innerHTML = `<p><strong>Razão Social:</strong> ${empresa.razao || 'N/A'}</p>`;
        document.getElementById('cnpjText').innerHTML = `<p><strong>CNPJ:</strong> ${empresa.cnpj || 'N/A'}</p>`;
        document.getElementById('cidadeText').innerHTML = `<p><strong>Cidade:</strong> ${empresa.cidade || 'N/A'}</p>`;
        document.getElementById('telefoneText').innerHTML = `<p><strong>Telefone:</strong> ${empresa.telefone || 'N/A'}</p>`;
        document.getElementById('emailText').innerHTML = `<p><strong>Email:</strong> ${empresa.email || 'N/A'}</p>`;
        
        await loadChatbots(id);
        await loadMaquinas(id);
        await loadPessoas(id);
        
        detailsModal.style.display = 'flex';
        detailsModal.offsetHeight;
        detailsModal.classList.add('show');
      } catch (error) {
        alert('Erro ao carregar detalhes');
      }
    }

    async function loadChatbots(empresaId) {
      try {
        console.log('Carregando chatbots para empresa:', empresaId);
        const response = await fetch(`http://localhost:3000/api/chatbots?empresa_id=${empresaId}`);
        const data = await response.json();
        console.log('Chatbots encontrados:', data);
        
        // Verificar se é array direto ou objeto com propriedade data
        const chatbots = Array.isArray(data) ? data : (data.data || []);
        
        const container = document.getElementById('chatbotsList');
        container.innerHTML = chatbots.map(chatbot => `
          <div class="entity-item entity-link" data-type="chatbot" data-id="${chatbot.id}">
            <div class="entity-info">
              <h4>${chatbot.login}</h4>
              <p>Servidor: ${chatbot.servidor || 'N/A'}</p>
              <p>Responsável: ${chatbot.responsavel || 'N/A'}</p>
            </div>
          </div>
        `).join('') || '<p style="text-align: center; color: #999; padding: 20px;">Nenhum chatbot cadastrado</p>';
      } catch (error) {
        console.error('Erro ao carregar chatbots:', error);
      }
    }

    async function loadMaquinas(empresaId) {
      try {
        console.log('Carregando máquinas para empresa:', empresaId);
        const response = await fetch(`http://localhost:3000/api/maquinas?empresa_id=${empresaId}`);
        const data = await response.json();
        console.log('Máquinas encontradas:', data);
        
        // Verificar se é array direto ou objeto com propriedade data
        const maquinas = Array.isArray(data) ? data : (data.data || []);
        
        const container = document.getElementById('maquinasList');
        container.innerHTML = maquinas.map(maquina => `
          <div class="entity-item entity-link" data-type="maquina" data-id="${maquina.id}">
            <div class="entity-info">
              <h4>${maquina.nome}</h4>
              <p>IP VPN: ${maquina.ipvpn || 'N/A'}</p>
              <p>Localidade: ${maquina.localidade || 'N/A'}</p>
            </div>
          </div>
        `).join('') || '<p style="text-align: center; color: #999; padding: 20px;">Nenhuma máquina cadastrada</p>';
      } catch (error) {
        console.error('Erro ao carregar máquinas:', error);
      }
    }

    async function loadPessoas(empresaId) {
      try {
        console.log('Carregando pessoas para empresa:', empresaId);
        const response = await fetch(`http://localhost:3000/api/contatos?empresa_id=${empresaId}`);
        const data = await response.json();
        console.log('Pessoas encontradas:', data);
        
        // Verificar se é array direto ou objeto com propriedade data
        const pessoas = Array.isArray(data) ? data : (data.data || []);
        
        const container = document.getElementById('pessoasList');
        container.innerHTML = pessoas.map(pessoa => `
          <div class="entity-item entity-link" data-type="pessoa" data-id="${pessoa.id}">
            <div class="entity-info">
              <h4>${pessoa.nome}</h4>
              <p>Departamento: ${pessoa.departamento || 'N/A'}</p>
              <p>Telefone: ${pessoa.telefone || 'N/A'}</p>
              <p>Email: ${pessoa.email || 'N/A'}</p>
            </div>
          </div>
        `).join('') || '<p style="text-align: center; color: #999; padding: 20px;">Nenhuma pessoa cadastrada</p>';
      } catch (error) {
        console.error('Erro ao carregar pessoas:', error);
      }
    }

    function openEntityDetails(type, id) {
      const urls = {
        chatbot: `/chatbots?view=${id}`,
        maquina: `/maquinas?view=${id}`,
        pessoa: `/pessoas?view=${id}`
      };
      
      if (urls[type]) {
        window.open(urls[type], '_blank');
      }
    }

    // Salvar empresa (criar ou editar)
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      try {
        const url = isEditing 
          ? `http://localhost:3000/api/empresas/${editingId}`
          : 'http://localhost:3000/api/empresas';
        
        const method = isEditing ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          closeModal();
          reloadWithoutAnimation();
        } else {
          alert('Erro ao salvar empresa');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    });
  });
</script>
