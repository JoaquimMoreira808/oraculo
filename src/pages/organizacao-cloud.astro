---\nimport Layout from '../layouts/Layout.astro';\nimport DataTable from '../components/DataTable.astro';\nimport TopBar from '../components/TopBar.astro';\n---\n\n<Layout title=\"Organizações Cloud\">\n  <TopBar />\n  <main>\n    <DataTable \n      title=\"Organizações Cloud\"\n      endpoint=\"/api/organizacao-cloud\"\n      columns={[\n        { key: 'id', label: 'ID', width: '80px' },\n        { key: 'nome_fantasia', label: 'Nome Fantasia', width: '200px' },\n        { key: 'razao_social', label: 'Razão Social', width: '250px' },\n        { key: 'cnpj', label: 'CNPJ', width: '150px' },\n        { key: 'cidade', label: 'Cidade', width: '150px' },\n        { key: 'revenda_nome', label: 'Revenda', width: '180px' }\n      ]}\n      fields={[\n        { name: 'nome_fantasia', label: 'Nome Fantasia', type: 'text', required: true },\n        { name: 'razao_social', label: 'Razão Social', type: 'text', required: true },\n        { name: 'cnpj', label: 'CNPJ', type: 'text' },\n        { name: 'telefone', label: 'Telefone', type: 'text' },\n        { name: 'email', label: 'Email', type: 'email' },\n        { name: 'cep', label: 'CEP', type: 'text' },\n        { name: 'cidade', label: 'Cidade', type: 'text' },\n        { \n          name: 'revenda_id', \n          label: 'Revenda Cloud', \n          type: 'select', \n          required: true,\n          endpoint: '/api/revenda-cloud',\n          valueKey: 'id',\n          labelKey: 'nome_fantasia'\n        }\n      ]}\n    />\n  </main>\n</Layout>