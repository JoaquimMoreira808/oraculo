---
import TopBar from '../components/TopBar.astro';
import Layout from '../layouts/Layout.astro';
import DataTable from '../components/DataTable.astro';
import ViewButton from '../components/ViewButton.astro';
import EditButton from '../components/EditButton.astro';
import DeleteButton from '../components/DeleteButton.astro';
import AddButton from '../components/AddButton.astro';
import ImportButton from '../components/ImportButton.astro';
import Modal from '../components/Modal.astro';
import ImportModal from '../components/ImportModal.astro';
import ImportAlert from '../components/ImportAlert.astro';
import FormField from '../components/FormField.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import SelectField from '../components/SelectField.astro';
import { fetchPaginatedData, fetchApiData } from '../lib/api.js';

export const prerender = false;

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 10;

const [contatosResult, revendas, perfils] = await Promise.all([
  fetchPaginatedData('contato-cloud', page, limit),
  fetchApiData('revenda-cloud'),
  fetchApiData('perfil-cloud')
]);

const { data: contatos, pagination } = contatosResult;
---

<Layout>
  <TopBar />
  <main>
    <div class="header">
      <h1 class="page-title">Contatos Cloud</h1>
      <div class="header-buttons">
        <AddButton text="Novo Contato" id="addContatoBtn" />
        <ImportButton text="Contatos" id="importContatoBtn" />
      </div>
    </div>
    
    <DataTable 
      columns={['Nome', 'Email', 'Revenda', 'Perfil']} 
      data={contatos}
      pagination={pagination}
      entityName="contato-cloud"
    >
      {contatos.map((contato) => (
        <tr>
          <td>{contato.nome}</td>
          <td>{contato.email}</td>
          <td>{contato.revenda_nome || '-'}</td>
          <td>{contato.perfil_nome || '-'}</td>
          <td>
            <div class="action-buttons">
              <ViewButton itemId={contato.id} />
              <EditButton itemId={contato.id} />
              <DeleteButton itemId={contato.id} />
            </div>
          </td>
        </tr>
      ))}
    </DataTable>
  </main>

  <Modal id="contatoModal" title="Novo Contato" formId="contatoForm">
    <FormField label="Nome" name="nome" required />
    <FormField label="Email" name="email" type="email" required />
    <FormField label="Senha" name="senha" type="password" required />
    <SelectField 
      label="Revenda Cloud" 
      name="revendacloud_id" 
      required 
      options={revendas.map(r => ({value: r.id, text: r.nome_fantasia}))}
    />
    <SelectField 
      label="Perfil Cloud" 
      name="perfil_id" 
      required 
      options={perfils.map(p => ({value: p.id, text: p.nome}))}
    />
  </Modal>

  <ConfirmModal 
    id="confirmModal" 
    title="Tem certeza que deseja excluir este contato?" 
    warning="Esse arquivo será perdido pra sempre! (Muito tempo)"
    confirmText="Excluir"
  />

  <ImportModal id="importModal" title="Importar Contatos" templateUrl="/templates/contato_cloud_template.csv" importType="contato-cloud" />

  <ImportAlert id="importAlert" />

  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-details>&times;</button>
      <h2 id="modalTitle">Detalhes do Contato</h2>
      
      <div class="details-stack">
        <div class="detail-item" id="nomeText"></div>
        <div class="detail-item" id="emailText"></div>
        <div class="detail-item" id="revendaText"></div>
        <div class="detail-item" id="perfilText"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  main {
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
    animation: fadeInScale 0.4s ease-out;
    position: relative;
    z-index: 1;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .header-buttons {
    display: flex;
    align-items: center;
  }

  .page-title {
    margin: 0;
    color: #333;
    font-size: 28px;
    font-weight: 600;
    font-family: 'Arimo', sans-serif;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal.show {
    display: flex;
    opacity: 1;
  }

  .modal.closing {
    opacity: 0;
  }

  .modal-content {
    background: white;
    border-radius: 8px;
    padding: 32px;
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 80vh;
    overflow-y: auto;
    transform: scale(0.9);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .modal.show .modal-content {
    transform: scale(1);
    opacity: 1;
  }

  .modal.closing .modal-content {
    transform: scale(0.9);
    opacity: 0;
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    color: #666;
    cursor: pointer;
    width: 32px;
    height: 32px;
  }

  .modal-close:hover {
    color: #333;
  }

  #modalTitle {
    margin: 0 0 24px 0;
    color: #333;
    font-family: 'Arimo', sans-serif;
    font-size: 24px;
  }

  .details-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .detail-item {
    background: white;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 6px;
  }

  .detail-item p {
    margin: 0;
    color: #333;
    font-size: 12px;
    font-family: 'Arimo', sans-serif;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('contatoModal');
    const importModal = document.getElementById('importModal');
    const confirmModal = document.getElementById('confirmModal');
    const detailsModal = document.getElementById('detailsModal');
    const addBtn = document.getElementById('addContatoBtn');
    const importBtn = document.getElementById('importContatoBtn');
    const form = document.getElementById('contatoForm');
    const modalTitle = modal.querySelector('.modal-title');
    const saveBtn = modal.querySelector('.btn-save');
    
    let isEditing = false;
    let editingId = null;
    let deleteId = null;

    const urlParams = new URLSearchParams(window.location.search);
    const viewId = urlParams.get('view');
    if (viewId) {
      setTimeout(() => showDetails(viewId), 100);
    }

    function reloadWithoutAnimation() {
      if (window.reloadWithoutAnimation) {
        window.reloadWithoutAnimation();
      } else {
        window.location.reload();
      }
    }

    addBtn.addEventListener('click', () => {
      isEditing = false;
      editingId = null;
      modalTitle.textContent = 'Novo Contato';
      saveBtn.textContent = 'Salvar';
      form.reset();
      modal.style.display = 'flex';
      modal.offsetHeight;
      modal.classList.add('show');
    });

    importBtn.addEventListener('click', () => {
      importModal.style.display = 'flex';
      importModal.offsetHeight;
      importModal.classList.add('show');
    });

    document.addEventListener('click', (e) => {
      if (e.target.closest('.delete-btn')) {
        const btn = e.target.closest('.delete-btn');
        deleteId = btn.getAttribute('data-item-id');
        confirmModal.classList.add('show');
      }
      if (e.target.closest('.view-btn')) {
        const btn = e.target.closest('.view-btn');
        const id = btn.getAttribute('data-item-id');
        showDetails(id);
      }
    });

    document.addEventListener('click', (e) => {
      if (e.target.matches('[data-close-modal="contatoModal"]')) {
        closeModal();
      }
      if (e.target.matches('[data-confirm-cancel="confirmModal"]')) {
        closeConfirmModal();
      }
      if (e.target.matches('[data-confirm-action="confirmModal"]')) {
        confirmDelete();
      }
      if (e.target.matches('[data-close-details]')) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function confirmDelete() {
      try {
        const response = await fetch(`http://localhost:3000/api/contato-cloud/${deleteId}`, {
          method: 'DELETE'
        });
        
        if (response.ok) {
          confirmModal.classList.add('closing');
          setTimeout(() => {
            confirmModal.classList.remove('show', 'closing');
            reloadWithoutAnimation();
          }, 300);
        } else {
          alert('Erro ao excluir contato');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    }

    function closeConfirmModal() {
      confirmModal.classList.add('closing');
      setTimeout(() => {
        confirmModal.classList.remove('show', 'closing');
        deleteId = null;
      }, 300);
    }

    function closeModal() {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.classList.remove('show', 'closing');
        modal.style.display = 'none';
        form.reset();
        isEditing = false;
        editingId = null;
      }, 300);
    }

    document.addEventListener('click', async (e) => {
      if (e.target.closest('.edit-btn')) {
        const btn = e.target.closest('.edit-btn');
        const id = btn.getAttribute('data-item-id');
        
        try {
          const response = await fetch(`http://localhost:3000/api/contato-cloud/${id}`);
          const contato = await response.json();
          
          isEditing = true;
          editingId = id;
          modalTitle.textContent = 'Editar Contato';
          saveBtn.textContent = 'Atualizar';
          
          form.nome.value = contato.nome || '';
          form.email.value = contato.email || '';
          form.senha.value = contato.senha || '';
          form.revendacloud_id.value = contato.revendacloud_id || '';
          form.perfil_id.value = contato.perfil_id || '';
          
          modal.style.display = 'flex';
          modal.offsetHeight;
          modal.classList.add('show');
        } catch (error) {
          alert('Erro ao carregar dados do contato');
        }
      }
    });
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    confirmModal.addEventListener('click', (e) => {
      if (e.target === confirmModal) closeConfirmModal();
    });

    detailsModal.addEventListener('click', (e) => {
      if (e.target === detailsModal) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function showDetails(id) {
      try {
        const response = await fetch(`http://localhost:3000/api/contato-cloud/${id}`);
        const contato = await response.json();
        
        // Buscar dados da revenda e perfil
        const [revendaResponse, perfilResponse] = await Promise.all([
          fetch(`http://localhost:3000/api/revenda-cloud/${contato.revendacloud_id}`),
          fetch(`http://localhost:3000/api/perfil-cloud/${contato.perfil_id}`)
        ]);
        
        const revenda = await revendaResponse.json();
        const perfil = await perfilResponse.json();
        
        document.getElementById('modalTitle').textContent = `Detalhes - ${contato.nome}`;
        
        document.getElementById('nomeText').innerHTML = `<p><strong>Nome:</strong> ${contato.nome}</p>`;
        document.getElementById('emailText').innerHTML = `<p><strong>Email:</strong> ${contato.email}</p>`;
        document.getElementById('revendaText').innerHTML = `<p><strong>Revenda:</strong> ${revenda.nome_fantasia || 'N/A'}</p>`;
        document.getElementById('perfilText').innerHTML = `<p><strong>Perfil:</strong> ${perfil.nome || 'N/A'}</p>`;
        
        detailsModal.style.display = 'flex';
        detailsModal.offsetHeight;
        detailsModal.classList.add('show');
      } catch (error) {
        alert('Erro ao carregar detalhes');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      try {
        const url = isEditing 
          ? `http://localhost:3000/api/contato-cloud/${editingId}`
          : 'http://localhost:3000/api/contato-cloud';
        
        const method = isEditing ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          closeModal();
          reloadWithoutAnimation();
        } else {
          alert('Erro ao salvar contato');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    });
  });
</script>