---\nimport Layout from '../layouts/Layout.astro';\nimport DataTable from '../components/DataTable.astro';\nimport TopBar from '../components/TopBar.astro';\n---\n\n<Layout title=\"Contatos Cloud\">\n  <TopBar />\n  <main>\n    <DataTable \n      title=\"Contatos Cloud\"\n      endpoint=\"/api/contato-cloud\"\n      columns={[\n        { key: 'id', label: 'ID', width: '80px' },\n        { key: 'nome', label: 'Nome', width: '200px' },\n        { key: 'email', label: 'Email', width: '200px' },\n        { key: 'revenda_nome', label: 'Revenda', width: '180px' },\n        { key: 'perfil_nome', label: 'Perfil', width: '150px' }\n      ]}\n      fields={[\n        { name: 'nome', label: 'Nome', type: 'text', required: true },\n        { name: 'email', label: 'Email', type: 'email', required: true },\n        { name: 'senha', label: 'Senha', type: 'password', required: true },\n        { \n          name: 'revendacloud_id', \n          label: 'Revenda Cloud', \n          type: 'select', \n          required: true,\n          endpoint: '/api/revenda-cloud',\n          valueKey: 'id',\n          labelKey: 'nome_fantasia'\n        },\n        { \n          name: 'perfil_id', \n          label: 'Perfil Cloud', \n          type: 'select', \n          required: true,\n          endpoint: '/api/perfil-cloud',\n          valueKey: 'id',\n          labelKey: 'nome'\n        }\n      ]}\n    />\n  </main>\n</Layout>