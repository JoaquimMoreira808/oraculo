---
import TopBar from '../components/TopBar.astro';
import Layout from '../layouts/Layout.astro';
import DataTable from '../components/DataTable.astro';
import ViewButton from '../components/ViewButton.astro';
import EditButton from '../components/EditButton.astro';
import DeleteButton from '../components/DeleteButton.astro';
import AddButton from '../components/AddButton.astro';
import Modal from '../components/Modal.astro';
import FormField from '../components/FormField.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import SelectField from '../components/SelectField.astro';
import { fetchPaginatedData, fetchApiData } from '../lib/api.js';

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 10;

const [contatosResult, empresas] = await Promise.all([
  fetchPaginatedData('contatos', page, limit),
  fetchApiData('empresas')
]);

const { data: contatos, pagination } = contatosResult;
---

<Layout>
  <TopBar />
  <main>
    <div class="header">
      <h1 class="page-title">Pessoas</h1>
      <AddButton text="Nova Pessoa" id="addContatoBtn" />
    </div>
    
    <DataTable 
      columns={['Empresa', 'Nome', 'Departamento', 'Telefone', 'Email']} 
      data={contatos}
      pagination={pagination}
      entityName="pessoas"
    >
      {contatos.map((contato) => (
        <tr>
          <td>{contato.empresa_nome || '-'}</td>
          <td>{contato.nome}</td>
          <td>{contato.departamento || '-'}</td>
          <td>{contato.telefone || '-'}</td>
          <td>{contato.email || '-'}</td>
          <td>
            <div class="action-buttons">
              <ViewButton itemId={contato.id} />
              <EditButton itemId={contato.id} />
              <DeleteButton itemId={contato.id} />
            </div>
          </td>
        </tr>
      ))}
    </DataTable>
  </main>

  <Modal id="contatoModal" title="Nova Pessoa" formId="contatoForm">
    <SelectField 
      label="Empresa" 
      name="empresa_id" 
      required 
      options={empresas.map(e => ({value: e.id, text: e.nome}))}
    />
    <FormField label="Nome" name="nome" required />
    <FormField label="Departamento" name="departamento" />
    <FormField label="Telefone" name="telefone" />
    <FormField label="Telefone 2" name="telefone2" />
    <FormField label="Email" name="email" type="email" />
  </Modal>

  <ConfirmModal 
    id="confirmModal" 
    title="Tem certeza que deseja excluir esta pessoa?" 
    warning="Esse arquivo será perdido pra sempre! (Muito tempo)"
    confirmText="Excluir"
  />

  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-details>&times;</button>
      <h2 id="modalTitle">Detalhes da Pessoa</h2>
      
      <div class="details-stack">
        <div class="detail-item" id="empresaText"></div>
        <div class="detail-item" id="nomeText"></div>
        <div class="detail-item" id="departamentoText"></div>
        <div class="detail-item" id="telefoneText"></div>
        <div class="detail-item" id="telefone2Text"></div>
        <div class="detail-item" id="emailText"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  main {
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
    animation: fadeInScale 0.4s ease-out;
    position: relative;
    z-index: 1;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .page-title {
    margin: 0;
    color: #333;
    font-size: 28px;
    font-weight: 600;
    font-family: 'Arimo', sans-serif;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal.show {
    display: flex;
    opacity: 1;
  }

  .modal.closing {
    opacity: 0;
  }

  .modal-content {
    background: white;
    border-radius: 8px;
    padding: 32px;
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 80vh;
    overflow-y: auto;
    transform: scale(0.9);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .modal.show .modal-content {
    transform: scale(1);
    opacity: 1;
  }

  .modal.closing .modal-content {
    transform: scale(0.9);
    opacity: 0;
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 24px;
    color: #666;
    cursor: pointer;
    width: 32px;
    height: 32px;
  }

  .modal-close:hover {
    color: #333;
  }

  #modalTitle {
    margin: 0 0 24px 0;
    color: #333;
    font-family: 'Arimo', sans-serif;
    font-size: 24px;
  }

  .details-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .detail-item {
    background: white;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 6px;
  }

  .detail-item p {
    margin: 0;
    color: #333;
    font-size: 12px;
    font-family: 'Arimo', sans-serif;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('contatoModal');
    const confirmModal = document.getElementById('confirmModal');
    const detailsModal = document.getElementById('detailsModal');
    const addBtn = document.getElementById('addContatoBtn');
    const form = document.getElementById('contatoForm');
    const modalTitle = modal.querySelector('.modal-title');
    const saveBtn = modal.querySelector('.btn-save');
    
    let isEditing = false;
    let editingId = null;
    let deleteId = null;

    // Verificar se deve abrir modal de detalhes automaticamente
    const urlParams = new URLSearchParams(window.location.search);
    const viewId = urlParams.get('view');
    if (viewId) {
      setTimeout(() => showDetails(viewId), 100);
    }

    async function refreshTable() {
      try {
        const response = await fetch('http://localhost:3000/api/contatos');
        const contatos = await response.json();
        const tbody = document.querySelector('tbody');
        tbody.innerHTML = contatos.map(contato => `
          <tr>
            <td>${contato.empresa_nome || '-'}</td>
            <td>${contato.nome}</td>
            <td>${contato.departamento || '-'}</td>
            <td>${contato.telefone || '-'}</td>
            <td>${contato.email || '-'}</td>
            <td>
              <div class="action-buttons" style="display: flex; gap: 8px; justify-content: center; align-items: center;">
                <button class="edit-btn" title="Editar" data-item-id="${contato.id}" style="background: rgba(24, 48, 84, 0.1); color: #183054; border: none; border-radius: 4px; padding: 6px 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 34px; height: 30px;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17 3C17.2626 2.73735 17.5744 2.52901 17.9176 2.38687C18.2608 2.24473 18.6286 2.17157 19 2.17157C19.3714 2.17157 19.7392 2.24473 20.0824 2.38687C20.4256 2.52901 20.7374 2.73735 21 3C21.2626 3.26264 21.471 3.57444 21.6131 3.9176C21.7553 4.26077 21.8284 4.62856 21.8284 5C21.8284 5.37143 21.7553 5.73923 21.6131 6.08239C21.471 6.42555 21.2626 6.73735 21 7L7.5 20.5L2 22L3.5 16.5L17 3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button class="delete-btn" title="Excluir" data-item-id="${contato.id}" style="background: rgba(245, 66, 87, 0.1); color: #f54257; border: none; border-radius: 4px; padding: 6px 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 34px; height: 30px;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 6H5H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 6V4C8 3.46957 8.21071 2.96086 8.58579 2.58579C8.96086 2.21071 9.46957 2 10 2H14C14.5304 2 15.0391 2.21071 15.4142 2.58579C15.7893 2.96086 16 3.46957 16 4V6M19 6V20C19 20.5304 18.7893 21.0391 18.4142 21.4142C18.0391 21.7893 17.5304 22 17 22H7C6.46957 22 5.96086 21.7893 5.58579 21.4142C5.21071 21.0391 5 20.5304 5 20V6H19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        `).join('');
      } catch (error) {
        console.error('Erro ao atualizar tabela:', error);
      }
    }

    addBtn.addEventListener('click', () => {
      isEditing = false;
      editingId = null;
      modalTitle.textContent = 'Nova Pessoa';
      saveBtn.textContent = 'Salvar';
      modal.style.display = 'flex';
      modal.offsetHeight;
      modal.classList.add('show');
    });

    document.addEventListener('click', async (e) => {
      if (e.target.matches('[data-close-modal="contatoModal"]')) {
        closeModal();
      }
      if (e.target.matches('[data-confirm-cancel="confirmModal"]')) {
        closeConfirmModal();
      }
      if (e.target.matches('[data-confirm-action="confirmModal"]')) {
        confirmDelete();
      }
      if (e.target.matches('[data-close-details]')) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
      if (e.target.closest('.delete-btn')) {
        const btn = e.target.closest('.delete-btn');
        deleteId = btn.getAttribute('data-item-id');
        confirmModal.classList.add('show');
      }
      if (e.target.closest('.view-btn')) {
        const btn = e.target.closest('.view-btn');
        const id = btn.getAttribute('data-item-id');
        showDetails(id);
      }
      if (e.target.closest('.edit-btn')) {
        const btn = e.target.closest('.edit-btn');
        const id = btn.getAttribute('data-item-id');
        editContato(id);
      }
    });

    async function editContato(id) {
      try {
        const response = await fetch(`http://localhost:3000/api/contatos/${id}`);
        const contato = await response.json();
        isEditing = true;
        editingId = id;
        modalTitle.textContent = 'Editar Pessoa';
        saveBtn.textContent = 'Atualizar';
        
        document.getElementById('empresa_id').value = contato.empresa_id || '';
        document.getElementById('nome').value = contato.nome || '';
        document.getElementById('departamento').value = contato.departamento || '';
        document.getElementById('telefone').value = contato.telefone || '';
        document.getElementById('telefone2').value = contato.telefone2 || '';
        document.getElementById('email').value = contato.email || '';
        
        modal.style.display = 'flex';
        modal.offsetHeight;
        modal.classList.add('show');
      } catch (error) {
        alert('Erro ao carregar dados da pessoa');
      }
    }

    async function confirmDelete() {
      try {
        const response = await fetch(`http://localhost:3000/api/contatos/${deleteId}`, { method: 'DELETE' });
        if (response.ok) {
          confirmModal.classList.add('closing');
          setTimeout(async () => {
            confirmModal.classList.remove('show', 'closing');
            await refreshTable();
          }, 300);
        } else {
          alert('Erro ao excluir pessoa');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    }

    function closeConfirmModal() {
      confirmModal.classList.add('closing');
      setTimeout(() => {
        confirmModal.classList.remove('show', 'closing');
        deleteId = null;
      }, 300);
    }

    function closeModal() {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.classList.remove('show', 'closing');
        modal.style.display = 'none';
        form.reset();
        isEditing = false;
        editingId = null;
      }, 300);
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    confirmModal.addEventListener('click', (e) => {
      if (e.target === confirmModal) closeConfirmModal();
    });

    detailsModal.addEventListener('click', (e) => {
      if (e.target === detailsModal) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function showDetails(id) {
      try {
        const response = await fetch(`http://localhost:3000/api/contatos/${id}`);
        const contato = await response.json();
        document.getElementById('modalTitle').textContent = `Detalhes - ${contato.nome}`;
        
        document.getElementById('empresaText').innerHTML = `<p><strong>Empresa:</strong> ${contato.empresa_nome || 'N/A'}</p>`;
        document.getElementById('nomeText').innerHTML = `<p><strong>Nome:</strong> ${contato.nome}</p>`;
        document.getElementById('departamentoText').innerHTML = `<p><strong>Departamento:</strong> ${contato.departamento || 'N/A'}</p>`;
        document.getElementById('telefoneText').innerHTML = `<p><strong>Telefone:</strong> ${contato.telefone || 'N/A'}</p>`;
        document.getElementById('telefone2Text').innerHTML = `<p><strong>Telefone 2:</strong> ${contato.telefone2 || 'N/A'}</p>`;
        document.getElementById('emailText').innerHTML = `<p><strong>Email:</strong> ${contato.email || 'N/A'}</p>`;
        
        detailsModal.style.display = 'flex';
        detailsModal.offsetHeight;
        detailsModal.classList.add('show');
      } catch (error) {
        alert('Erro ao carregar detalhes');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      try {
        const url = isEditing ? `http://localhost:3000/api/contatos/${editingId}` : 'http://localhost:3000/api/contatos';
        const method = isEditing ? 'PUT' : 'POST';
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (response.ok) {
          closeModal();
          setTimeout(async () => {
            await refreshTable();
          }, 300);
        } else {
          const errorData = await response.json();
          alert(`Erro ao salvar: ${errorData.error || 'Erro desconhecido'}`);
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    });
  });
</script>