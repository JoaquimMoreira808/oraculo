---
import TopBar from '../components/TopBar.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<TopBar />
	<main class="search-container">
		<div class="search-wrapper">
			<div class="hero-section">
				<h1 class="search-title">Omni-Data</h1>
				<p class="search-subtitle">Sistema inteligente de inventário e gestão</p>
			</div>
			
			<div class="search-box">
				<div class="search-input-container">
					<div class="search-icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M21 21L16.514 16.506M19 10.5C19 15.194 15.194 19 10.5 19S2 15.194 2 10.5 5.806 2 10.5 2 19 5.806 19 10.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<input 
						id="search-input"
						type="text" 
						placeholder="Pesquisar no Omni-Data..." 
						class="search-input"
						autocomplete="off"
					/>
					<div class="search-actions">
						<select id="search-filter" class="search-filter">
							<option value="all">Todas</option>
							<option value="dedicado">Dedicado</option>
							<option value="cloud">Cloud</option>
						</select>
						<button class="clear-search" id="clear-search" title="Limpar busca">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</button>
					</div>
				</div>
			</div>
			
			<div id="loading" class="loading hidden">
				<div class="loading-spinner"></div>
				<span>Buscando resultados...</span>
			</div>
			
			<div id="search-results-card" class="search-results-card hidden">
				<div id="results-content" class="results-content"></div>
			</div>
		</div>
		
		<div id="related-cards" class="related-cards hidden"></div>
		
		<!-- Modal de Registros Relacionados -->
		<div id="relatedModal" class="modal">
			<div class="modal-content">
				<button class="modal-close" data-close-related>&times;</button>
				<h2 id="relatedModalTitle">Registros Relacionados</h2>
				<div id="relatedModalContent" class="related-modal-content"></div>
			</div>
		</div>
	</main>
</Layout>

<style>
	.search-container {
		display: flex;
		justify-content: center;
		padding: var(--space-2xl) var(--space-lg);
		min-height: calc(100vh - 72px);
		position: relative;
		background: var(--bg-primary);
	}

	.search-wrapper {
		width: 100%;
		max-width: 800px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xl);
	}

	.hero-section {
		text-align: center;
		margin-bottom: var(--space-lg);
	}

	.search-title {
		font-size: 48px;
		margin: 0 0 var(--space-md) 0;
		color: var(--text-primary);
		font-weight: 700;
		font-family: 'Inter', sans-serif;
		background: var(--gradient-silver-dark);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		text-shadow: 0 0 40px rgba(192, 192, 192, 0.2);
		animation: fadeIn 0.8s ease-out;
	}

	.search-subtitle {
		font-size: 18px;
		color: var(--text-muted);
		margin: 0;
		font-weight: 400;
		animation: fadeIn 1s ease-out 0.2s both;
	}

	.search-box {
		width: 100%;
		position: relative;
		animation: fadeIn 1.2s ease-out 0.4s both;
	}

	.search-input-container {
		position: relative;
		width: 100%;
		display: flex;
		align-items: center;
		background: var(--bg-input);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-2xl);
		box-shadow: var(--shadow-lg);
		transition: all var(--transition-normal);
		overflow: hidden;
	}

	.search-input-container:focus-within {
		border-color: var(--accent-primary);
		box-shadow: var(--shadow-glow);
		transform: translateY(-2px);
		background: var(--bg-elevated);
	}

	.search-icon {
		padding: 0 var(--space-lg);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		transition: color var(--transition-fast);
	}

	.search-input-container:focus-within .search-icon {
		color: var(--accent-primary);
	}

	.search-input {
		flex: 1;
		padding: var(--space-lg) 0;
		font-size: 18px;
		border: none;
		outline: none;
		background: transparent;
		color: var(--text-primary);
		font-family: 'Inter', sans-serif;
		font-weight: 400;
	}

	.search-input::placeholder {
		color: var(--text-placeholder);
		font-weight: 400;
	}

	.search-actions {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		padding-right: var(--space-md);
	}

	.search-filter {
		padding: var(--space-sm) var(--space-md);
		background: var(--bg-elevated);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		font-size: 14px;
		font-weight: 500;
		cursor: pointer;
		transition: all var(--transition-fast);
		font-family: inherit;
		outline: none;
		appearance: auto;
	}

	.search-filter:hover {
		background: var(--bg-hover);
		border-color: var(--silver-muted);
		color: var(--silver-light);
	}

	.clear-search {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: var(--bg-elevated);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		color: var(--text-muted);
		cursor: pointer;
		transition: all var(--transition-fast);
		opacity: 0;
		visibility: hidden;
		transform: scale(0.8);
	}

	.clear-search.visible {
		opacity: 1;
		visibility: visible;
		transform: scale(1);
	}

	.clear-search:hover {
		background: var(--error-bg);
		border-color: var(--error);
		color: var(--error);
		transform: scale(1.05);
	}


	/* Modal de Registros Relacionados */
	.modal {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(8px);
		z-index: 3000;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity var(--transition-normal);
	}

	.modal.show {
		display: flex;
		opacity: 1;
	}

	.modal.closing {
		opacity: 0;
	}

	.modal-content {
		background: var(--bg-modal);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-xl);
		padding: var(--space-2xl);
		max-width: 700px;
		width: 90%;
		position: relative;
		max-height: 85vh;
		overflow-y: auto;
		transform: scale(0.95) translateY(20px);
		opacity: 0;
		transition: all var(--transition-normal);
		box-shadow: var(--shadow-xl);
	}

	.modal.show .modal-content {
		transform: scale(1) translateY(0);
		opacity: 1;
	}

	.modal.closing .modal-content {
		transform: scale(0.95) translateY(20px);
		opacity: 0;
	}

	.modal-close {
		position: absolute;
		top: var(--space-lg);
		right: var(--space-lg);
		background: var(--bg-elevated);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		font-size: 20px;
		color: var(--text-muted);
		cursor: pointer;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all var(--transition-fast);
	}

	.modal-close:hover {
		background: var(--bg-hover);
		color: var(--text-primary);
		border-color: var(--border-hover);
	}

	#relatedModalTitle {
		margin: 0 0 var(--space-xl) 0;
		color: var(--text-primary);
		font-family: 'Inter', sans-serif;
		font-size: 24px;
		font-weight: 600;
	}

	.related-modal-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	:global(.modal-related-card) {
		background: var(--bg-elevated);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-lg);
		padding: var(--space-lg);
		transition: all var(--transition-fast);
	}

	:global(.modal-related-card:hover) {
		background: var(--bg-hover);
		border-color: var(--border-hover);
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
	}

	:global(.modal-related-card h4) {
		margin: 0 0 var(--space-md) 0;
		color: var(--text-primary);
		font-size: 18px;
		font-weight: 600;
		font-family: 'Inter', sans-serif;
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	:global(.modal-related-card h4::before) {
		content: '🔗';
		font-size: 16px;
		opacity: 0.7;
	}

	:global(.modal-related-item) {
		padding: var(--space-md);
		background: var(--bg-card);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		margin-bottom: var(--space-sm);
		transition: all var(--transition-fast);
	}

	:global(.modal-related-item:hover) {
		background: var(--bg-hover);
		border-color: var(--accent-primary);
		transform: translateX(4px);
	}

	:global(.modal-related-item:last-child) {
		margin-bottom: 0;
	}

	:global(.modal-related-name) {
		color: var(--text-primary);
		font-size: 15px;
		font-weight: 500;
		font-family: 'Inter', sans-serif;
	}

	:global(.modal-related-link) {
		text-decoration: none;
		display: block;
		transition: all var(--transition-fast);
	}

	:global(.modal-related-link:hover .modal-related-name) {
		color: var(--accent-primary);
	}

	.loading {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-md);
		margin-top: var(--space-xl);
		color: var(--accent-primary);
		font-size: 14px;
		font-weight: 500;
		animation: fadeIn 0.3s ease-out;
	}

	.loading-spinner {
		width: 20px;
		height: 20px;
		border: 2px solid var(--border-primary);
		border-top: 2px solid var(--accent-primary);
		border-radius: 50%;
		animation: spin 1s linear infinite;
	}

	@keyframes spin {
		0% { transform: rotate(0deg); }
		100% { transform: rotate(360deg); }
	}

	.hidden {
		display: none !important;
	}

	.search-results-card {
		width: 100%;
		margin-top: var(--space-xl);
		background: var(--bg-card);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-xl);
		max-height: 75vh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		animation: slideDown 0.4s ease-out;
		backdrop-filter: blur(10px);
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes slideIn {
		from {
			opacity: 0;
			transform: translateX(20px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	:global(.card-header) {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--space-xl);
		border-bottom: 1px solid var(--border-primary);
		background: var(--bg-elevated);
		position: relative;
	}

	:global(.card-header::before) {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: var(--gradient-primary);
	}

	:global(.card-header h3) {
		margin: 0;
		color: var(--text-primary);
		font-size: 20px;
		font-weight: 600;
		font-family: 'Inter', sans-serif;
	}

	.close-btn {
		background: #f1f3f4;
		border: none;
		font-size: 18px;
		cursor: pointer;
		color: #5f6368;
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		transition: all 0.2s ease;
	}

	.close-btn:hover {
		background: #e8eaed;
		color: #202124;
	}

	.results-content {
		overflow-y: auto;
		max-height: 60vh;
		padding: 0;
		background: var(--bg-card);
	}

	/* Aplicar scrollbar personalizada para resultados */
	.results-content::-webkit-scrollbar {
		width: 6px;
	}

	.results-content::-webkit-scrollbar-track {
		background: var(--bg-elevated);
		border-radius: 3px;
		margin: 2px;
	}

	.results-content::-webkit-scrollbar-thumb {
		background: var(--border-primary);
		border-radius: 3px;
		transition: all var(--transition-fast);
	}

	.results-content::-webkit-scrollbar-thumb:hover {
		background: var(--accent-primary);
		box-shadow: 0 0 6px rgba(59, 130, 246, 0.3);
	}

	:global(.results-count) {
		padding: var(--space-md) var(--space-xl);
		background: var(--bg-elevated);
		color: var(--text-muted);
		font-size: 13px;
		font-weight: 500;
		border-top: 1px solid var(--border-primary);
		text-align: center;
		font-family: 'Inter', sans-serif;
	}

	:global(.no-results) {
		text-align: center;
		padding: var(--space-2xl);
		color: var(--text-muted);
		font-size: 16px;
		font-family: 'Inter', sans-serif;
		background: var(--bg-card);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
	}

	:global(.no-results::before) {
		content: '🔍';
		font-size: 48px;
		opacity: 0.5;
	}

	:global(.no-results p) {
		margin: 0;
		font-weight: 500;
		color: var(--text-secondary);
	}

	:global(.empresa-result) {
		padding: var(--space-xl);
		border-bottom: 1px solid var(--border-primary);
		background: var(--bg-card);
		transition: all var(--transition-fast);
		position: relative;
		overflow: hidden;
	}

	:global(.empresa-result::before) {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: transparent;
		transition: background var(--transition-fast);
	}

	:global(.empresa-result:hover) {
		background: var(--bg-hover);
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
	}

	:global(.empresa-result:hover::before) {
		background: var(--accent-primary);
	}

	:global(.empresa-result:last-child) {
		border-bottom: none;
	}

	:global(.record-name) {
		margin: 0 0 var(--space-xs) 0;
		color: var(--text-primary);
		font-size: 18px;
		font-weight: 600;
		font-family: 'Inter', sans-serif;
		transition: color var(--transition-fast);
	}

	:global(.record-type) {
		color: var(--text-muted);
		font-size: 14px;
		font-weight: 500;
		font-family: 'Inter', sans-serif;
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-xs) var(--space-sm);
		background: var(--bg-elevated);
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-primary);
	}

	:global(.record-link) {
		text-decoration: none;
		display: block;
		margin-bottom: var(--space-md);
		transition: all var(--transition-fast);
		position: relative;
		z-index: 1;
		pointer-events: auto;
	}

	:global(.record-link:hover .record-name) {
		color: var(--accent-primary);
	}

	:global(.expand-btn) {
		background: var(--bg-elevated);
		color: var(--text-secondary);
		border: 1px solid var(--border-primary);
		padding: var(--space-sm) var(--space-md);
		border-radius: var(--radius-md);
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
		transition: all var(--transition-fast);
		font-family: 'Inter', sans-serif;
		position: relative;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
	}

	:global(.expand-btn::after) {
		content: '→';
		transition: transform var(--transition-fast);
	}

	:global(.expand-btn:hover) {
		background: var(--accent-bg);
		border-color: var(--accent-primary);
		color: var(--accent-primary);
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
	}

	:global(.expand-btn:hover::after) {
		transform: translateX(2px);
	}

	/* Responsividade */
	@media (max-width: 768px) {
		.search-container {
			padding: var(--space-lg) var(--space-md);
		}
		
		.search-title {
			font-size: 36px;
		}
		
		.search-subtitle {
			font-size: 16px;
		}
		
		.search-input {
			font-size: 16px;
			padding: var(--space-md) 0;
		}
		
		.search-actions {
			gap: var(--space-xs);
		}
	}
</style>

<script>
	import { universalSearch, fetchRelatedRecords } from '../lib/api.js';

	const searchInput = document.getElementById('search-input');
	const loading = document.getElementById('loading');
	const resultsCard = document.getElementById('search-results-card');
	const resultsContent = document.getElementById('results-content');
	const relatedCards = document.getElementById('related-cards');
	const relatedModal = document.getElementById('relatedModal');
	const relatedModalContent = document.getElementById('relatedModalContent');
	const relatedModalTitle = document.getElementById('relatedModalTitle');
	const searchFilter = document.getElementById('search-filter');
	const clearSearch = document.getElementById('clear-search');

	let searchTimeout;
	let currentResults = [];
	let currentFilter = 'all';

	const tableLabels = {
		empresa: 'Empresa',
		maquina: 'Máquina',
		equipamento: 'Equipamento',
		pessoa: 'Pessoa',
		contato: 'Contato',
		chatbot: 'Chatbot',
		numerobot: 'Número Bot',
		rede: 'Rede',
		linha: 'Linha',
		senha: 'Senha',
		tronco: 'Tronco',
		// Cloud types
		revenda_cloud: 'Revenda Cloud',
		perfil_cloud: 'Perfil Cloud',
		contato_cloud: 'Contato Cloud',
		organizacao_cloud: 'Organização Cloud'
	};

	const fieldLabels = {
		nome: 'Nome',
		razao: 'Razão Social',
		cnpj: 'CNPJ',
		cidade: 'Cidade',
		telefone: 'Telefone',
		email: 'Email',
		ip: 'IP',
		vpn: 'VPN',
		operacao: 'Operação',
		local: 'Local'
	};

	function showLoading() {
		loading.classList.remove('hidden');
	}

	function hideLoading() {
		loading.classList.add('hidden');
	}

	function getDetailUrl(type, id) {
		const routes = {
			empresa: `/empresas?view=${id}`,
			maquina: `/maquinas?view=${id}`,
			equipamento: `/equipamentos?view=${id}`,
			contato: `/pessoas?view=${id}`,
			chatbot: `/chatbots?view=${id}`,
			linha: `/linhas?view=${id}`,
			// Cloud routes
			revenda_cloud: `/revenda-cloud?view=${id}`,
			perfil_cloud: `/perfil-cloud?view=${id}`,
			contato_cloud: `/contato-cloud?view=${id}`,
			organizacao_cloud: `/organizacao-cloud?view=${id}`
		};
		return routes[type] || '#';
	}

	function showResults(results) {
		currentResults = results;
		
		if (results.length === 0) {
			showNoResults();
			return;
		}

		let html = `
			<div class="card-header">
				<h3>Resultados da Busca</h3>
			</div>
		`;
		
		results.forEach((result, index) => {
			const displayName = result.type === 'chatbot' ? result.subtitle : result.title;
			const detailUrl = getDetailUrl(result.type, result.id);
			html += `
				<div class="empresa-result">
					<a href="${detailUrl}" class="record-link">
						<h4 class="record-name">${displayName}</h4>
						<span class="record-type">${tableLabels[result.type] || result.type}</span>
					</a>
					<button class="expand-btn" onclick="expandRecord('${result.type}', ${result.id}, ${index})">Ver Relacionados</button>
				</div>
			`;
		});
		
		html += `<div class="results-count">${results.length} ${results.length === 1 ? 'resultado encontrado' : 'resultados encontrados'}</div>`;
		
		resultsContent.innerHTML = html;
		
		// Aplicar animação
		resultsCard.style.animation = 'none';
		resultsCard.classList.remove('hidden');
		resultsCard.offsetHeight; // Force reflow
		resultsCard.style.animation = 'slideDown 0.3s ease-out';
	}

	function showNoResults() {
		resultsContent.innerHTML = `
			<div class="no-results">
				<p>Ops! Nenhum resultado encontrado...</p>
			</div>
		`;
		resultsCard.classList.remove('hidden');
	}

	function closeResults() {
		resultsCard.classList.add('hidden');
		resultsContent.innerHTML = '';
		relatedCards.classList.add('hidden');
		relatedCards.innerHTML = '';
		closeRelatedModal();
	}

	function closeRelatedModal() {
		if (relatedModal.classList.contains('show')) {
			relatedModal.classList.add('closing');
			setTimeout(() => {
				relatedModal.classList.remove('show', 'closing');
				relatedModal.style.display = 'none';
				relatedModalContent.innerHTML = '';
			}, 300);
		}
	}

	async function expandRecord(type, id, index) {
		try {
			const relatedRecords = await fetchRelatedRecords(type, id);
			showRelatedModal(relatedRecords, currentResults[index]);
		} catch (error) {
			console.error('Erro ao buscar relacionados:', error);
		}
	}

	function showRelatedModal(records, originalRecord) {
		const displayName = originalRecord.type === 'chatbot' ? originalRecord.subtitle : originalRecord.title;
		relatedModalTitle.textContent = `Relacionados - ${displayName}`;
		
		if (records.length === 0) {
			relatedModalContent.innerHTML = `
				<div style="text-align: center; padding: var(--space-2xl); color: var(--text-muted);">
					<div style="font-size: 48px; margin-bottom: var(--space-md); opacity: 0.5;">🔍</div>
					<p style="margin: 0; font-size: 16px; font-weight: 500;">Nada por aqui...</p>
					<p style="margin: var(--space-xs) 0 0 0; font-size: 14px; opacity: 0.8;">Nenhum registro relacionado encontrado</p>
				</div>
			`;
		} else {
			const groupedRecords = records.reduce((acc, record) => {
				if (!acc[record.type]) acc[record.type] = [];
				acc[record.type].push(record);
				return acc;
			}, {});

			let html = '';
			Object.entries(groupedRecords).forEach(([type, items]) => {
				html += `
					<div class="modal-related-card">
						<h4>${tableLabels[type] || type} (${items.length})</h4>
						${items.map(item => {
							const detailUrl = getDetailUrl(item.type, item.id);
							return `
								<div class="modal-related-item">
									<a href="${detailUrl}" class="modal-related-link">
										<div class="modal-related-name">${item.nome}</div>
									</a>
								</div>
							`;
						}).join('')}
					</div>
				`;
			});
			relatedModalContent.innerHTML = html;
		}
		
		relatedModal.style.display = 'flex';
		relatedModal.offsetHeight;
		relatedModal.classList.add('show');
	}

	// Tornar função global para uso no onclick
	window.expandRecord = expandRecord;

	// Filtro de categoria
	searchFilter?.addEventListener('change', () => {
		currentFilter = searchFilter.value;
		if (searchInput.value.trim()) performSearch(searchInput.value.trim());
	});

	// Event listeners para o modal de relacionados
	document.addEventListener('click', (e) => {
		if (e.target.matches('[data-close-related]')) {
			closeRelatedModal();
		}
	});

	// Fechar modal ao clicar fora
	relatedModal?.addEventListener('click', (e) => {
		if (e.target === relatedModal) {
			closeRelatedModal();
		}
	});

	// Fechar modal com ESC
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			if (relatedModal.classList.contains('show')) {
				closeRelatedModal();
			} else {
				closeResults();
			}
		}
	});



	// Botão de limpar busca
	clearSearch?.addEventListener('click', () => {
		searchInput.value = '';
		closeResults();
		clearSearch.classList.remove('visible');
		searchInput.focus();
	});



	async function performSearch(query) {
		if (!query || query.trim().length < 2) {
			return;
		}

		showLoading();
		
		try {
			const results = await universalSearch(query, currentFilter);
			showResults(results);
		} catch (error) {
			console.error('Erro na busca:', error);
			showNoResults();
		} finally {
			hideLoading();
		}
	}

	searchInput.addEventListener('input', (e) => {
		const query = e.target.value;
		
		// Mostrar/ocultar botão de limpar
		if (query.trim()) {
			clearSearch?.classList.add('visible');
		} else {
			clearSearch?.classList.remove('visible');
		}
		
		if (searchTimeout) {
			clearTimeout(searchTimeout);
		}

		if (!query || query.trim().length < 2) {
			closeResults();
			hideLoading();
			return;
		}

		searchTimeout = setTimeout(() => {
			performSearch(query);
		}, 400);
	});

	searchInput.addEventListener('keypress', (e) => {
		if (e.key === 'Enter') {
			if (searchTimeout) {
				clearTimeout(searchTimeout);
			}
			performSearch(e.target.value);
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			if (relatedModal.classList.contains('show')) {
				closeRelatedModal();
			} else {
				closeResults();
			}
		}
	});

	// Verificar se há parâmetro de pesquisa na URL
	document.addEventListener('DOMContentLoaded', () => {
		const urlParams = new URLSearchParams(window.location.search);
		const searchQuery = urlParams.get('search');
		if (searchQuery) {
			searchInput.value = searchQuery;
			performSearch(searchQuery);
			// Limpar o parâmetro da URL
			window.history.replaceState({}, document.title, window.location.pathname);
		}
	});
</script>