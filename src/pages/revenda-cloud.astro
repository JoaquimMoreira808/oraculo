---
import TopBar from '../components/TopBar.astro';
import Layout from '../layouts/Layout.astro';
import DataTable from '../components/DataTable.astro';
import ViewButton from '../components/ViewButton.astro';
import EditButton from '../components/EditButton.astro';
import DeleteButton from '../components/DeleteButton.astro';
import AddButton from '../components/AddButton.astro';
import ImportButton from '../components/ImportButton.astro';
import Modal from '../components/Modal.astro';
import ImportModal from '../components/ImportModal.astro';
import ImportAlert from '../components/ImportAlert.astro';
import FormField from '../components/FormField.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import { fetchPaginatedData } from '../lib/api.js';


const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 10;

const { data: revendas, pagination } = await fetchPaginatedData('revenda-cloud', page, limit);
---

<Layout>
  <TopBar />
  <main>
    <div class="header">
      <h1 class="page-title">Revendas Cloud</h1>
      <div class="header-buttons">
        <AddButton text="Nova Revenda" id="addRevendaBtn" />
        <ImportButton text="Revendas" id="importRevendaBtn" />
      </div>
    </div>
    
    <DataTable 
      columns={['Nome Fantasia', 'Razão Social', 'CNPJ', 'Telefone', 'Email']} 
      data={revendas}
      pagination={pagination}
      entityName="revenda-cloud"
    >
      {revendas.map((revenda) => (
        <tr>
          <td>{revenda.nome_fantasia}</td>
          <td>{revenda.razao_social}</td>
          <td>{revenda.cnpj || '-'}</td>
          <td>{revenda.telefone || '-'}</td>
          <td>{revenda.email || '-'}</td>
          <td>
            <div class="action-buttons">
              <ViewButton itemId={revenda.id} />
              <EditButton itemId={revenda.id} />
              <DeleteButton itemId={revenda.id} />
            </div>
          </td>
        </tr>
      ))}
    </DataTable>
  </main>

  <Modal id="revendaModal" title="Nova Revenda" formId="revendaForm">
    <FormField label="Nome Fantasia" name="nome_fantasia" required />
    <FormField label="Razão Social" name="razao_social" required />
    <FormField label="CNPJ" name="cnpj" />
    <FormField label="Telefone" name="telefone" />
    <FormField label="Email" name="email" type="email" />
  </Modal>

  <ConfirmModal 
    id="confirmModal" 
    title="Tem certeza que deseja excluir esta revenda?" 
    warning="Esse arquivo será perdido pra sempre! (Muito tempo)"
    confirmText="Excluir"
  />

  <ImportModal id="importModal" title="Importar Revendas" templateUrl="/templates/revenda_cloud_template.csv" importType="revenda-cloud" />

  <ImportAlert id="importAlert" />

  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-details>&times;</button>
      <h2 id="modalTitle">Detalhes da Revenda</h2>
      
      <div class="tabs">
        <button class="tab-btn active" data-tab="detalhes">Detalhes</button>
        <button class="tab-btn" data-tab="perfis">Perfis</button>
        <button class="tab-btn" data-tab="contatos">Contatos</button>
        <button class="tab-btn" data-tab="organizacoes">Organizações</button>
      </div>

      <div id="detalhes" class="tab-pane active">
        <div class="details-stack">
          <div class="detail-item" id="nomeFantasiaText"></div>
          <div class="detail-item" id="razaoSocialText"></div>
          <div class="detail-item" id="cnpjText"></div>
          <div class="detail-item" id="telefoneText"></div>
          <div class="detail-item" id="emailText"></div>
        </div>
      </div>

      <div id="perfis" class="tab-pane">
        <div id="perfisList"></div>
      </div>

      <div id="contatos" class="tab-pane">
        <div id="contatosList"></div>
      </div>

      <div id="organizacoes" class="tab-pane">
        <div id="organizacoesList"></div>
      </div>
    </div>
  </div>
  <!-- Modal de detalhes para Perfil -->
  <div id="perfilDetailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-perfil-details>&times;</button>
      <h2 id="perfilModalTitle">Detalhes do Perfil</h2>
      <div class="details-stack">
        <div class="detail-item" id="perfilNomeText"></div>
        <div class="detail-item" id="perfilRevendaText"></div>
      </div>
    </div>
  </div>

  <!-- Modal de detalhes para Contato -->
  <div id="contatoDetailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-contato-details>&times;</button>
      <h2 id="contatoModalTitle">Detalhes do Contato</h2>
      <div class="details-stack">
        <div class="detail-item" id="contatoNomeText"></div>
        <div class="detail-item" id="contatoEmailText"></div>
        <div class="detail-item" id="contatoRevendaText"></div>
        <div class="detail-item" id="contatoPerfilText"></div>
      </div>
    </div>
  </div>

  <!-- Modal de detalhes para Organização -->
  <div id="organizacaoDetailsModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" data-close-organizacao-details>&times;</button>
      <h2 id="organizacaoModalTitle">Detalhes da Organização</h2>
      <div class="details-stack">
        <div class="detail-item" id="orgNomeFantasiaText"></div>
        <div class="detail-item" id="orgRazaoSocialText"></div>
        <div class="detail-item" id="orgCnpjText"></div>
        <div class="detail-item" id="orgTelefoneText"></div>
        <div class="detail-item" id="orgEmailText"></div>
        <div class="detail-item" id="orgCepText"></div>
        <div class="detail-item" id="orgCidadeText"></div>
        <div class="detail-item" id="orgRevendaText"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  main {
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
    animation: fadeInScale 0.4s ease-out;
    position: relative;
    z-index: 1;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .header-buttons {
    display: flex;
    align-items: center;
  }

  .page-title {
    margin: 0;
    color: #333;
    font-size: 28px;
    font-weight: 600;
    font-family: 'Arimo', sans-serif;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .modal.show {
    display: flex;
    opacity: 1;
  }

  .modal.closing {
    opacity: 0;
  }

  .modal-content {
    background: var(--bg-modal);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 85vh;
    overflow-y: auto;
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-xl);
  }

  .modal.show .modal-content {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .modal.closing .modal-content {
    transform: scale(0.95) translateY(20px);
    opacity: 0;
  }

  .modal-close {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    font-size: 20px;
    color: var(--text-muted);
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .modal-close:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  #modalTitle {
    margin: 0 0 var(--space-xl) 0;
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 24px;
    font-weight: 600;
  }

  .details-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .detail-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    transition: all var(--transition-fast);
  }

  .detail-item:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
  }

  .detail-item p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    font-family: 'Inter', sans-serif;
  }

  .detail-item strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .tabs {
    display: flex;
    gap: var(--space-xs);
    border-bottom: 1px solid var(--border-primary);
    margin-bottom: var(--space-xl);
  }

  .tab-btn {
    background: none;
    border: none;
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    color: var(--text-muted);
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all var(--transition-fast);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .tab-btn:hover {
    color: var(--silver-light);
    background: var(--bg-hover);
  }

  .tab-btn.active {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
    background: var(--accent-bg);
    font-weight: 600;
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  :global(.entity-item) {
    background: var(--bg-elevated);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
    transition: all var(--transition-fast);
  }

  :global(.entity-item:hover) {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }

  :global(.entity-info) {
    flex: 1;
  }

  :global(.entity-info h4) {
    margin: 0 0 var(--space-xs) 0;
    color: var(--text-primary);
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }

  :global(.entity-info p) {
    margin: 0 0 var(--space-xs) 0;
    color: var(--text-muted);
    font-size: 13px;
    font-family: 'Inter', sans-serif;
  }

  :global(.entity-link) {
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  :global(.entity-link:hover) {
    background: var(--bg-hover);
  }

  :global(.entity-link h4) {
    color: var(--accent-primary);
    text-decoration: underline;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('revendaModal');
    const importModal = document.getElementById('importModal');
    const confirmModal = document.getElementById('confirmModal');
    const detailsModal = document.getElementById('detailsModal');
    const perfilDetailsModal = document.getElementById('perfilDetailsModal');
    const contatoDetailsModal = document.getElementById('contatoDetailsModal');
    const organizacaoDetailsModal = document.getElementById('organizacaoDetailsModal');
    const addBtn = document.getElementById('addRevendaBtn');
    const importBtn = document.getElementById('importRevendaBtn');
    const form = document.getElementById('revendaForm');
    const modalTitle = modal.querySelector('.modal-title');
    const saveBtn = modal.querySelector('.btn-save');
    
    let isEditing = false;
    let editingId = null;
    let deleteId = null;
    let currentRevendaId = null;

    refreshTable();

    const urlParams = new URLSearchParams(window.location.search);
    const viewId = urlParams.get('view');
    if (viewId) {
      setTimeout(() => showDetails(viewId), 100);
    }

    async function refreshTable() {
      try {
        const res = await fetch('/api/revenda-cloud', { credentials: 'include' });
        const result = await res.json();
        const items = Array.isArray(result) ? result : (result.data || []);
        document.querySelector('tbody').innerHTML = items.map(r => `
          <tr>
            <td>${r.nome_fantasia}</td>
            <td>${r.razao_social}</td>
            <td>${r.cnpj || '-'}</td>
            <td>${r.telefone || '-'}</td>
            <td>${r.email || '-'}</td>
            <td><div class="action-buttons" style="display:flex;gap:8px;justify-content:center">
              <button class="view-btn" data-item-id="${r.id}" style="background:rgba(24,48,84,0.1);color:#183054;border:none;border-radius:4px;padding:6px 8px;cursor:pointer;width:34px;height:30px;display:flex;align-items:center;justify-content:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M1 12S5 4 12 4S23 12 23 12S19 20 12 20S1 12 1 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg></button>
              <button class="edit-btn" data-item-id="${r.id}" style="background:rgba(24,48,84,0.1);color:#183054;border:none;border-radius:4px;padding:6px 8px;cursor:pointer;width:34px;height:30px;display:flex;align-items:center;justify-content:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M17 3L21 7L7.5 20.5L2 22L3.5 16.5L17 3Z" stroke="currentColor" stroke-width="2"/></svg></button>
              <button class="delete-btn" data-item-id="${r.id}" style="background:rgba(245,66,87,0.1);color:#f54257;border:none;border-radius:4px;padding:6px 8px;cursor:pointer;width:34px;height:30px;display:flex;align-items:center;justify-content:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 6H21M8 6V4C8 3.47 8.21 2.96 8.59 2.59C8.96 2.21 9.47 2 10 2H14C14.53 2 15.04 2.21 15.41 2.59C15.79 2.96 16 3.47 16 4V6M19 6V20C19 20.53 18.79 21.04 18.41 21.41C18.04 21.79 17.53 22 17 22H7C6.47 22 5.96 21.79 5.59 21.41C5.21 21.04 5 20.53 5 20V6H19Z" stroke="currentColor" stroke-width="2"/></svg></button>
            </div></td>
          </tr>`).join('');
      } catch(e) {}
    }

    function reloadWithoutAnimation() {
      if (window.reloadWithoutAnimation) {
        window.reloadWithoutAnimation();
      } else {
        window.location.reload();
      }
    }

    addBtn.addEventListener('click', () => {
      isEditing = false;
      editingId = null;
      modalTitle.textContent = 'Nova Revenda';
      saveBtn.textContent = 'Salvar';
      form.reset();
      modal.style.display = 'flex';
      modal.offsetHeight;
      modal.classList.add('show');
    });

    importBtn.addEventListener('click', () => {
      importModal.style.display = 'flex';
      importModal.offsetHeight;
      importModal.classList.add('show');
    });

    document.addEventListener('click', (e) => {
      if (e.target.closest('.delete-btn')) {
        const btn = e.target.closest('.delete-btn');
        deleteId = btn.getAttribute('data-item-id');
        confirmModal.classList.add('show');
      }
      if (e.target.closest('.view-btn')) {
        const btn = e.target.closest('.view-btn');
        const id = btn.getAttribute('data-item-id');
        showDetails(id);
      }
      if (e.target.matches('.tab-btn')) {
        const tabName = e.target.getAttribute('data-tab');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
        document.getElementById(tabName).classList.add('active');
      }
      if (e.target.closest('.entity-link')) {
        const item = e.target.closest('.entity-link');
        const type = item.getAttribute('data-type');
        const id = item.getAttribute('data-id');
        openEntityDetails(type, id);
      }
    });

    document.addEventListener('click', (e) => {
      if (e.target.matches('[data-close-modal="revendaModal"]')) {
        closeModal();
      }
      if (e.target.matches('[data-confirm-cancel="confirmModal"]')) {
        closeConfirmModal();
      }
      if (e.target.matches('[data-confirm-action="confirmModal"]')) {
        confirmDelete();
      }
      if (e.target.matches('[data-close-details]')) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
      if (e.target.matches('[data-close-perfil-details]')) {
        perfilDetailsModal.classList.add('closing');
        setTimeout(() => {
          perfilDetailsModal.classList.remove('show', 'closing');
          perfilDetailsModal.style.display = 'none';
        }, 300);
      }
      if (e.target.matches('[data-close-contato-details]')) {
        contatoDetailsModal.classList.add('closing');
        setTimeout(() => {
          contatoDetailsModal.classList.remove('show', 'closing');
          contatoDetailsModal.style.display = 'none';
        }, 300);
      }
      if (e.target.matches('[data-close-organizacao-details]')) {
        organizacaoDetailsModal.classList.add('closing');
        setTimeout(() => {
          organizacaoDetailsModal.classList.remove('show', 'closing');
          organizacaoDetailsModal.style.display = 'none';
        }, 300);
      }
    });

    async function confirmDelete() {
      try {
        const response = await fetch(`/api/revenda-cloud/${deleteId}`, {
          credentials: 'include',
          method: 'DELETE'
        });
        
        if (response.ok) {
          confirmModal.classList.add('closing');
          setTimeout(() => {
            confirmModal.classList.remove('show', 'closing');
            reloadWithoutAnimation();
          }, 300);
        } else {
          alert('Erro ao excluir revenda');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    }

    function closeConfirmModal() {
      confirmModal.classList.add('closing');
      setTimeout(() => {
        confirmModal.classList.remove('show', 'closing');
        deleteId = null;
      }, 300);
    }

    function closeModal() {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.classList.remove('show', 'closing');
        modal.style.display = 'none';
        form.reset();
        isEditing = false;
        editingId = null;
      }, 300);
    }

    document.addEventListener('click', async (e) => {
      if (e.target.closest('.edit-btn')) {
        const btn = e.target.closest('.edit-btn');
        const id = btn.getAttribute('data-item-id');
        
        try {
          const response = await fetch(`/api/revenda-cloud/${id}`, { credentials: 'include' });
          const revenda = await response.json();
          
          isEditing = true;
          editingId = id;
          modalTitle.textContent = 'Editar Revenda';
          saveBtn.textContent = 'Atualizar';
          
          form.nome_fantasia.value = revenda.nome_fantasia || '';
          form.razao_social.value = revenda.razao_social || '';
          form.cnpj.value = revenda.cnpj || '';
          form.telefone.value = revenda.telefone || '';
          form.email.value = revenda.email || '';
          
          modal.style.display = 'flex';
          modal.offsetHeight;
          modal.classList.add('show');
        } catch (error) {
          alert('Erro ao carregar dados da revenda');
        }
      }
    });
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    confirmModal.addEventListener('click', (e) => {
      if (e.target === confirmModal) closeConfirmModal();
    });

    detailsModal.addEventListener('click', (e) => {
      if (e.target === detailsModal) {
        detailsModal.classList.add('closing');
        setTimeout(() => {
          detailsModal.classList.remove('show', 'closing');
          detailsModal.style.display = 'none';
        }, 300);
      }
    });

    // Event listeners para fechar modais clicando fora
    [perfilDetailsModal, contatoDetailsModal, organizacaoDetailsModal].forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('closing');
          setTimeout(() => {
            modal.classList.remove('show', 'closing');
            modal.style.display = 'none';
          }, 300);
        }
      });
    });

    async function showDetails(id) {
      try {
        currentRevendaId = id;
        const response = await fetch(`/api/revenda-cloud/${id}`, { credentials: 'include' });
        const revenda = await response.json();
        document.getElementById('modalTitle').textContent = `Detalhes - ${revenda.nome_fantasia}`;
        
        document.getElementById('nomeFantasiaText').innerHTML = `<p><strong>Nome Fantasia:</strong> ${revenda.nome_fantasia}</p>`;
        document.getElementById('razaoSocialText').innerHTML = `<p><strong>Razão Social:</strong> ${revenda.razao_social || 'N/A'}</p>`;
        document.getElementById('cnpjText').innerHTML = `<p><strong>CNPJ:</strong> ${revenda.cnpj || 'N/A'}</p>`;
        document.getElementById('telefoneText').innerHTML = `<p><strong>Telefone:</strong> ${revenda.telefone || 'N/A'}</p>`;
        document.getElementById('emailText').innerHTML = `<p><strong>Email:</strong> ${revenda.email || 'N/A'}</p>`;
        
        await loadPerfis(id);
        await loadContatos(id);
        await loadOrganizacoes(id);
        
        detailsModal.style.display = 'flex';
        detailsModal.offsetHeight;
        detailsModal.classList.add('show');
      } catch (error) {
        alert('Erro ao carregar detalhes');
      }
    }

    async function loadPerfis(revendaId) {
      try {
        const response = await fetch(`/api/perfil-cloud?revendacloud_id=${revendaId}`, { credentials: 'include' });
        const data = await response.json();
        const perfis = Array.isArray(data) ? data : (data.data || []);
        
        const container = document.getElementById('perfisList');
        container.innerHTML = perfis.map(perfil => `
          <div class="entity-item entity-link" data-type="perfil_cloud" data-id="${perfil.id}">
            <div class="entity-info">
              <h4>${perfil.nome}</h4>
            </div>
          </div>
        `).join('') || '<p style="text-align: center; color: #999; padding: 20px;">Nenhum perfil cadastrado</p>';
      } catch (error) {
        console.error('Erro ao carregar perfis:', error);
      }
    }

    async function loadContatos(revendaId) {
      try {
        const response = await fetch(`/api/contato-cloud?revendacloud_id=${revendaId}`, { credentials: 'include' });
        const data = await response.json();
        const contatos = Array.isArray(data) ? data : (data.data || []);
        
        const container = document.getElementById('contatosList');
        container.innerHTML = contatos.map(contato => `
          <div class="entity-item entity-link" data-type="contato_cloud" data-id="${contato.id}">
            <div class="entity-info">
              <h4>${contato.nome}</h4>
              <p>Email: ${contato.email || 'N/A'}</p>
            </div>
          </div>
        `).join('') || '<p style="text-align: center; color: #999; padding: 20px;">Nenhum contato cadastrado</p>';
      } catch (error) {
        console.error('Erro ao carregar contatos:', error);
      }
    }

    async function loadOrganizacoes(revendaId) {
      try {
        const response = await fetch(`/api/organizacao-cloud?revenda_id=${revendaId}`, { credentials: 'include' });
        const data = await response.json();
        const organizacoes = Array.isArray(data) ? data : (data.data || []);
        
        const container = document.getElementById('organizacoesList');
        container.innerHTML = organizacoes.map(org => `
          <div class="entity-item entity-link" data-type="organizacao_cloud" data-id="${org.id}">
            <div class="entity-info">
              <h4>${org.nome_fantasia}</h4>
              <p>Razão Social: ${org.razao_social || 'N/A'}</p>
              <p>Cidade: ${org.cidade || 'N/A'}</p>
            </div>
          </div>
        `).join('') || '<p style="text-align: center; color: #999; padding: 20px;">Nenhuma organização cadastrada</p>';
      } catch (error) {
        console.error('Erro ao carregar organizações:', error);
      }
    }

    async function openEntityDetails(type, id) {
      try {
        switch(type) {
          case 'perfil_cloud':
            await showPerfilDetails(id);
            break;
          case 'contato_cloud':
            await showContatoDetails(id);
            break;
          case 'organizacao_cloud':
            await showOrganizacaoDetails(id);
            break;
        }
      } catch (error) {
        console.error('Erro ao carregar detalhes:', error);
        alert('Erro ao carregar detalhes');
      }
    }

    async function showPerfilDetails(id) {
      const response = await fetch(`/api/perfil-cloud/${id}`, { credentials: 'include' });
      const perfil = await response.json();
      
      const revendaResponse = await fetch(`/api/revenda-cloud/${perfil.revendacloud_id}`, { credentials: 'include' });
      const revenda = await revendaResponse.json();
      
      document.getElementById('perfilModalTitle').textContent = `Detalhes - ${perfil.nome}`;
      document.getElementById('perfilNomeText').innerHTML = `<p><strong>Nome:</strong> ${perfil.nome}</p>`;
      document.getElementById('perfilRevendaText').innerHTML = `<p><strong>Revenda:</strong> ${revenda.nome_fantasia || 'N/A'}</p>`;
      
      perfilDetailsModal.style.display = 'flex';
      perfilDetailsModal.offsetHeight;
      perfilDetailsModal.classList.add('show');
    }

    async function showContatoDetails(id) {
      const response = await fetch(`/api/contato-cloud/${id}`, { credentials: 'include' });
      const contato = await response.json();
      
      const [revendaResponse, perfilResponse] = await Promise.all([
        fetch(`/api/revenda-cloud/${contato.revendacloud_id}`),
        fetch(`/api/perfil-cloud/${contato.perfil_id}`)
      ]);
      
      const revenda = await revendaResponse.json();
      const perfil = await perfilResponse.json();
      
      document.getElementById('contatoModalTitle').textContent = `Detalhes - ${contato.nome}`;
      document.getElementById('contatoNomeText').innerHTML = `<p><strong>Nome:</strong> ${contato.nome}</p>`;
      document.getElementById('contatoEmailText').innerHTML = `<p><strong>Email:</strong> ${contato.email}</p>`;
      document.getElementById('contatoRevendaText').innerHTML = `<p><strong>Revenda:</strong> ${revenda.nome_fantasia || 'N/A'}</p>`;
      document.getElementById('contatoPerfilText').innerHTML = `<p><strong>Perfil:</strong> ${perfil.nome || 'N/A'}</p>`;
      
      contatoDetailsModal.style.display = 'flex';
      contatoDetailsModal.offsetHeight;
      contatoDetailsModal.classList.add('show');
    }

    async function showOrganizacaoDetails(id) {
      const response = await fetch(`/api/organizacao-cloud/${id}`, { credentials: 'include' });
      const org = await response.json();
      
      const revendaResponse = await fetch(`/api/revenda-cloud/${org.revenda_id}`, { credentials: 'include' });
      const revenda = await revendaResponse.json();
      
      document.getElementById('organizacaoModalTitle').textContent = `Detalhes - ${org.nome_fantasia}`;
      document.getElementById('orgNomeFantasiaText').innerHTML = `<p><strong>Nome Fantasia:</strong> ${org.nome_fantasia}</p>`;
      document.getElementById('orgRazaoSocialText').innerHTML = `<p><strong>Razão Social:</strong> ${org.razao_social}</p>`;
      document.getElementById('orgCnpjText').innerHTML = `<p><strong>CNPJ:</strong> ${org.cnpj || 'N/A'}</p>`;
      document.getElementById('orgTelefoneText').innerHTML = `<p><strong>Telefone:</strong> ${org.telefone || 'N/A'}</p>`;
      document.getElementById('orgEmailText').innerHTML = `<p><strong>Email:</strong> ${org.email || 'N/A'}</p>`;
      document.getElementById('orgCepText').innerHTML = `<p><strong>CEP:</strong> ${org.cep || 'N/A'}</p>`;
      document.getElementById('orgCidadeText').innerHTML = `<p><strong>Cidade:</strong> ${org.cidade || 'N/A'}</p>`;
      document.getElementById('orgRevendaText').innerHTML = `<p><strong>Revenda:</strong> ${revenda.nome_fantasia || 'N/A'}</p>`;
      
      organizacaoDetailsModal.style.display = 'flex';
      organizacaoDetailsModal.offsetHeight;
      organizacaoDetailsModal.classList.add('show');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      try {
        const url = isEditing 
          ? `/api/revenda-cloud/${editingId}`
          : '/api/revenda-cloud';
        
        const method = isEditing ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          credentials: 'include',
          method,
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        if (response.ok) {
          closeModal();
          reloadWithoutAnimation();
        } else {
          alert('Erro ao salvar revenda');
        }
      } catch (error) {
        alert('Erro de conexão');
      }
    });
  });
</script>