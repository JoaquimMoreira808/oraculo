    };

    window.editTronco = async (id) => {
      try {
        const response = await fetch(`http://localhost:3000/api/troncos/${id}`);
        const tronco = await response.json();
        currentEntity = 'troncos';
        editingEntityId = id;
        document.getElementById('troncoModal').querySelector('.modal-title').textContent = 'Editar Tronco E1';
        document.querySelector('#troncoForm [name="ddd"]').value = tronco.ddd || '';
        document.querySelector('#troncoForm [name="prefixo"]').value = tronco.prefixo || '';
        document.querySelector('#troncoForm [name="numero_ini"]').value = tronco.numero_ini || '';
        document.querySelector('#troncoForm [name="numero_fin"]').value = tronco.numero_fin || '';
        document.querySelector('#troncoForm [name="equipamento"]').value = tronco.equipamento || '';
        document.querySelector('#troncoForm [name="placalink"]').value = tronco.placalink || '';
        document.querySelector('#troncoForm [name="operadora"]').value = tronco.operadora || '';
        document.querySelector('#troncoForm [name="obs"]').value = tronco.obs || '';
        document.getElementById('troncoModal').style.display = 'flex';
        document.getElementById('troncoModal').classList.add('show');
      } catch (error) {
        alert('Erro ao carregar tronco');
      }
    };

    window.deleteEntity = async (entity, id) => {
      if (confirm('Tem certeza que deseja excluir este item?')) {
        try {
          const entityMap = {
            'equipamento': 'equipamentos',
            'rede': 'rede',
            'linha': 'linhas', 
            'senha': 'senhas',
            'troncoe1': 'troncos'
          };
          
          const apiEntity = entityMap[entity];
          const response = await fetch(`http://localhost:3000/api/${apiEntity}/${id}`, { method: 'DELETE' });
          if (response.ok) {
            // Recarregar a lista correspondente
            switch(entity) {
              case 'equipamento': await loadEquipamentos(currentMaquinaId); break;
              case 'rede': await loadRede(currentMaquinaId); break;
              case 'linha': await loadLinhas(currentMaquinaId); break;
              case 'senha': await loadSenhas(currentMaquinaId); break;
              case 'troncoe1': await loadTroncos(currentMaquinaId); break;
            }
          } else {
            alert('Erro ao excluir item');
          }
        } catch (error) {
          alert('Erro de conexão');
        }
      }
    };

    // Event listeners para botões de adicionar
    document.getElementById('addEquipamento').addEventListener('click', () => {
      currentEntity = 'equipamentos';
      editingEntityId = null;
      document.getElementById('equipamentoModal').querySelector('.modal-title').textContent = 'Novo Equipamento';
      document.getElementById('equipamentoForm').reset();
      document.getElementById('equipamentoModal').style.display = 'flex';
      document.getElementById('equipamentoModal').classList.add('show');
    });

    document.getElementById('addRede').addEventListener('click', () => {
      currentEntity = 'rede';
      editingEntityId = null;
      document.getElementById('redeModal').querySelector('.modal-title').textContent = 'Nova Configuração de Rede';
      document.getElementById('redeForm').reset();
      document.getElementById('redeModal').style.display = 'flex';
      document.getElementById('redeModal').classList.add('show');
    });

    document.getElementById('addLinha').addEventListener('click', () => {
      currentEntity = 'linhas';
      editingEntityId = null;
      document.getElementById('linhaModal').querySelector('.modal-title').textContent = 'Nova Linha';
      document.getElementById('linhaForm').reset();
      document.getElementById('linhaModal').style.display = 'flex';
      document.getElementById('linhaModal').classList.add('show');
    });

    document.getElementById('addSenha').addEventListener('click', () => {
      currentEntity = 'senhas';
      editingEntityId = null;
      document.getElementById('senhaModal').querySelector('.modal-title').textContent = 'Nova Senha';
      document.getElementById('senhaForm').reset();
      document.getElementById('senhaModal').style.display = 'flex';
      document.getElementById('senhaModal').classList.add('show');
    });

    document.getElementById('addTronco').addEventListener('click', () => {
      currentEntity = 'troncos';
      editingEntityId = null;
      document.getElementById('troncoModal').querySelector('.modal-title').textContent = 'Novo Tronco E1';
      document.getElementById('troncoForm').reset();
      document.getElementById('troncoModal').style.display = 'flex';
      document.getElementById('troncoModal').classList.add('show');
    });

    // Submissão dos formulários das entidades
    ['equipamentoForm', 'redeForm', 'linhaForm', 'senhaForm', 'troncoForm'].forEach(formId => {
      document.getElementById(formId).addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);
        data.maquina_id = currentMaquinaId;
        
        try {
          const entityMap = {
            'equipamentoForm': 'equipamentos',
            'redeForm': 'rede', 
            'linhaForm': 'linhas',
            'senhaForm': 'senhas',
            'troncoForm': 'troncos'
          };
          
          const entity = entityMap[formId];
          const url = editingEntityId 
            ? `http://localhost:3000/api/${entity}/${editingEntityId}`
            : `http://localhost:3000/api/${entity}`;
          const method = editingEntityId ? 'PUT' : 'POST';
          
          const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          
          if (response.ok) {
            // Fechar modal
            const modal = e.target.closest('.modal');
            modal.classList.remove('show');
            modal.style.display = 'none';
            
            // Recarregar lista
            switch(entity) {
              case 'equipamentos': await loadEquipamentos(currentMaquinaId); break;
              case 'rede': await loadRede(currentMaquinaId); break;
              case 'linhas': await loadLinhas(currentMaquinaId); break;
              case 'senhas': await loadSenhas(currentMaquinaId); break;
              case 'troncos': await loadTroncos(currentMaquinaId); break;
            }
          } else {
            const errorData = await response.json();
            alert(`Erro ao salvar: ${errorData.error || 'Erro desconhecido'}`);
          }
        } catch (error) {
          console.error('Erro:', error);
          alert('Erro de conexão');
        }
      });
    });
  });
</script>