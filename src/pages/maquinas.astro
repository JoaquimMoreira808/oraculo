    // Funções globais para edição
    window.editEquipamento = async (id) => {
      try {
        const response = await fetch(`http://localhost:3000/api/equipamentos/${id}`);
        const eq = await response.json();
        currentEntity = 'equipamentos';
        editingEntityId = id;
        document.getElementById('equipamentoModal').querySelector('.modal-title').textContent = 'Editar Equipamento';
        document.querySelector('#equipamentoForm [name="nome"]').value = eq.nome || '';
        document.querySelector('#equipamentoForm [name="tipo"]').value = eq.tipo || '';
        document.querySelector('#equipamentoForm [name="ip"]').value = eq.ip || '';
        document.querySelector('#equipamentoForm [name="senha"]').value = eq.senha || '';
        document.getElementById('equipamentoModal').style.display = 'flex';
        document.getElementById('equipamentoModal').classList.add('show');
      } catch (error) {
        alert('Erro ao carregar equipamento');
      }
    };

    window.editRede = async (id) => {
      try {
        const response = await fetch(`http://localhost:3000/api/rede/${id}`);
        const rede = await response.json();
        currentEntity = 'rede';
        editingEntityId = id;
        document.getElementById('redeModal').querySelector('.modal-title').textContent = 'Editar Rede';
        document.querySelector('#redeForm [name="ip"]').value = rede.ip || '';
        document.querySelector('#redeForm [name="placa"]').value = rede.placa || '';
        document.querySelector('#redeForm [name="tipo"]').value = rede.tipo || '';
        document.getElementById('redeModal').style.display = 'flex';
        document.getElementById('redeModal').classList.add('show');
      } catch (error) {
        alert('Erro ao carregar rede');
      }
    };

    window.editLinha = async (id) => {
      try {
        const response = await fetch(`http://localhost:3000/api/linhas/${id}`);
        const linha = await response.json();
        currentEntity = 'linhas';
        editingEntityId = id;
        document.getElementById('linhaModal').querySelector('.modal-title').textContent = 'Editar Linha';
        document.querySelector('#linhaForm [name="numero"]').value = linha.numero || '';
        document.querySelector('#linhaForm [name="tipo"]').value = linha.tipo || '';
        document.querySelector('#linhaForm [name="operadora"]').value = linha.operadora || '';
        document.querySelector('#linhaForm [name="senha"]').value = linha.senha || '';
